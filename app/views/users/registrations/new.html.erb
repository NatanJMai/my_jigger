<% @title = "Create Account" %>

<div class="authentication-page">
  <div class="auth-bg-pattern">
    <div class="auth-pattern-circle auth-pattern-1"></div>
    <div class="auth-pattern-circle auth-pattern-2"></div>
    <div class="auth-pattern-circle auth-pattern-3"></div>
  </div>
  
  <div class="container-fluid">
    <div class="row justify-content-center align-items-center min-vh-100">
      <div class="col-xxl-4 col-xl-5 col-lg-6 col-md-7 col-sm-9">
        <div class="auth-card">
          <div class="text-center mb-4">
            <a href="<%= root_path %>" class="auth-logo">
              <span class="logo-dark">
                <span class="logo-lg">MyJigger</span>
              </span>
              <span class="logo-light">
                <span class="logo-lg">MyJigger</span>
              </span>
            </a>
            <p class="text-muted mt-3 mb-4">Create your account to get started</p>
          </div>

          <%= render "devise/shared/error_messages", resource: resource %>

          <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth-form" }) do |f| %>
            <div class="mb-3">
              <label class="form-label" for="userEmail">Email address</label>
              <%= f.input :email,
                          required: true,
                          autofocus: true,
                          label: false,
                          placeholder: "you@example.com",
                          input_html: { 
                            class: "form-control", 
                            id: "userEmail", 
                            autocomplete: "email",
                            placeholder: "Enter your email"
                          } %>
            </div>

            <div class="mb-3">
              <label class="form-label" for="userPassword">Password</label>
              <%= f.input :password,
                          required: true,
                          label: false,
                          placeholder: "Create a password",
                          hint: ("#{@minimum_password_length} characters minimum" if @minimum_password_length),
                          input_html: { 
                            class: "form-control", 
                            id: "userPassword", 
                            autocomplete: "new-password" 
                          } %>
            </div>

            <div class="mb-4">
              <label class="form-label" for="userPasswordConfirmation">Confirm Password</label>
              <%= f.input :password_confirmation,
                          required: true,
                          label: false,
                          placeholder: "Confirm your password",
                          input_html: { 
                            class: "form-control", 
                            id: "userPasswordConfirmation", 
                            autocomplete: "new-password" 
                          } %>
            </div>

            <div class="d-grid">
              <%= f.button :submit, "Create Account", class: "btn btn-primary btn-lg fw-semibold" %>
            </div>
          <% end %>

          <div class="text-center mt-4">
            <p class="text-muted mb-0">Already have an account? 
              <a href='<%= new_user_session_path %>' class="text-muted text-decoration-none fw-semibold">Sign in</a>
            </p>
          </div>
        </div>

        <div class="text-center mt-4">
          <p class="text-muted mb-0">&copy; <%= Date.current.year %> MyJigger. All rights reserved.</p>
        </div>
      </div>
    </div>
  </div>
</div>
