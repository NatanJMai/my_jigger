<!-- Sidenav Menu Start -->
<div class="sidenav-menu">
  <!-- Brand Logo -->
  <a class="logo" href="<%#= url_for(:controller => 'dashboard', :action => 'index') %>">
<span class="logo logo-light">
<span class="logo-lg">MyJigger</span>
<span class="logo-sm">MyJigger</span>
</span>
    <span class="logo logo-dark">
<span class="logo-lg">MyJigger</span>
<span class="logo-sm">MyJigger</span>
</span>
  </a>
  <!-- Sidebar Hover Menu Toggle Button -->
  <button class="button-on-hover">
    <i class="ti ti-menu-4 fs-22 align-middle"></i>
  </button>
  <!-- Full Sidebar Menu Close Button -->
  <button class="button-close-offcanvas">
    <i class="ti ti-x align-middle"></i>
  </button>
  <div class="scrollbar" data-simplebar="">
    <!-- User -->
    <% if current_user.present? %>
      <div class="sidenav-user">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <a class="link-reset" href='<%#= url_for(:controller => 'users', :action => 'profile') %>'>
              <% 
                # Determine user role
                user_role = if @organization.present?
                  if @organization.manager_id == current_user.id
                    "Owner"
                  elsif current_user.employers.include?(@organization)
                    "Employee"
                  else
                    "User"
                  end
                elsif current_user.consultant?
                  "Consultant"
                else
                  "User"
                end
                
                # Get user initials for avatar fallback
                initials = if current_user.first_name.present? && current_user.last_name.present?
                  "#{current_user.first_name[0]}#{current_user.last_name[0]}"
                elsif current_user.first_name.present?
                  current_user.first_name[0..1].upcase
                elsif current_user.email.present?
                  current_user.email[0..1].upcase
                else
                  "U"
                end
              %>
              <div class="rounded-circle mb-2 avatar-md d-inline-flex align-items-center justify-content-center bg-primary text-white fw-bold" style="width: 48px; height: 48px; font-size: 18px;">
                <%= initials %>
              </div>
              <span class="sidenav-user-name fw-bold d-block"><%= current_user.display_name.presence || current_user.email %></span>
              <span class="fs-12 fw-semibold" data-lang="user-role"><%= user_role %></span>
            </a>
          </div>
        <div>
          <a aria-expanded="false" aria-haspopup="false" class="dropdown-toggle drop-arrow-none link-reset sidenav-user-set-icon" data-bs-offset="0,12" data-bs-toggle="dropdown" href="#!">
            <i class="ti ti-settings fs-24 align-middle ms-1"></i>
          </a>
          <div class="dropdown-menu">
            <!-- Header -->
            <div class="dropdown-header noti-title">
              <h6 class="text-overflow m-0">Welcome back!</h6>
            </div>
            <!-- My Profile -->
            <a class="dropdown-item" href="<%#= url_for(:controller => 'users', :action => 'profile') %>">
              <i class="ti ti-user-circle me-2 fs-17 align-middle"></i>
              <span class="align-middle">Profile</span>
            </a>
            <!-- Notifications -->
            <a class="dropdown-item" data-turbo="false" href="javascript:void(0);">
              <i class="ti ti-bell-ringing me-2 fs-17 align-middle"></i>
              <span class="align-middle">Notifications</span>
            </a>
            <!-- Settings -->
            <a class="dropdown-item" data-turbo="false" href="javascript:void(0);">
              <i class="ti ti-settings-2 me-2 fs-17 align-middle"></i>
              <span class="align-middle">Account Settings</span>
            </a>
            <!-- Support -->
            <a class="dropdown-item" data-turbo="false" href="javascript:void(0);">
              <i class="ti ti-headset me-2 fs-17 align-middle"></i>
              <span class="align-middle">Support Center</span>
            </a>
            <!-- Divider -->
            <div class="dropdown-divider"></div>
            <!-- Lock -->
            <a class="dropdown-item" href='<%#= url_for(:controller => 'auth', :action => 'lock_screen') %>'>
              <i class="ti ti-lock me-2 fs-17 align-middle"></i>
              <span class="align-middle">Lock Screen</span>
            </a>
            <!-- Logout -->
            <%= link_to destroy_user_session_path, method: :delete, class: "dropdown-item fw-semibold" do %>
              <i class="ti ti-logout-2 me-2 fs-17 align-middle"></i>
              <span class="align-middle">Log Out</span>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    <% end %>
    <!--- Sidenav Menu -->
    <ul class="side-nav">
      <li class="side-nav-title" data-lang="apps-title">Organisations</li>
      <li class="side-nav-item">
        <a class="side-nav-link" href="<%= url_for(:controller => 'admin/organizations', :action => 'index') %>">
          <span class="menu-icon"><i data-lucide="building-2"></i></span>
          <span class="menu-text" data-lang="organisations"> Organisations </span>
        </a>
      </li>

      <% if @organization&.persisted? %>
        <li class="side-nav-title mt-2" data-lang="menu-title"><%= @organization %></li>
        <li class="side-nav-item">
          <a class="side-nav-link" href="<%= admin_organization_menus_path(@organization) %> ">
            <span class="menu-icon"><i data-lucide="notebook-pen"></i></span>
            <span class="menu-text" data-lang="organisations"> Menus </span>
          </a>
        </li>

        <li class="side-nav-item">
          <a class="side-nav-link" href='<%= admin_organization_items_path(@organization) %>'>
            <span class="menu-icon"><i data-lucide="package"></i></span>
            <span class="menu-text" data-lang="eco-products">Products</span>
          </a>
        </li>

        <li class="side-nav-item">
          <a class="side-nav-link" href='<%= admin_organization_ingredients_path(@organization) %>'>
            <span class="menu-icon"><i data-lucide="leaf"></i></span>
            <span class="menu-text" data-lang="eco-pro-listing">Ingredients</span>
          </a>
        </li>

        <li class="side-nav-item">
          <a class="side-nav-link" href='<%= admin_organization_categories_path(@organization) %>'>
            <span class="menu-icon"><i data-lucide="layout-grid"></i></span>
            <span class="menu-text" data-lang="eco-categories">Categories</span>
          </a>
        </li>

        <li class="side-nav-item">
          <a class="side-nav-link" href='<%= admin_organization_orders_path(@organization) %>'>
            <span class="menu-icon"><i data-lucide="clipboard-list"></i></span>
            <span class="menu-text" data-lang="eco-orders-list">Orders</span>
          </a>
        </li>
      <% end %>
    </ul>
  </div>
</div>
<!-- Sidenav Menu End -->