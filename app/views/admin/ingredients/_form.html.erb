<%= simple_form_for([:admin, (ingredient.persisted? ? nil : organization), ingredient].compact, html: { id: 'add-ingredient-form', class: 'js-modal-form', data: { remote: 'true', reload: 'true' } }) do |f| %>
  <div class="modal-body">
    <div class="row g-3">
      <div class="col-md-8">
        <div class="mb-3">
          <label class="form-label"><%= t("ingredients.ingredient") %> <span class="text-danger">*</span></label>
          <%= f.input :name,
                      label: false,
                      required: true,
                      input_html: { placeholder: 'e.g., Premium Vodka', class: 'form-control' },
                      wrapper: false %>
        </div>

        <div class="mb-3">
          <label class="form-label"><%= t("common.description") %> <span class="text-muted">(<%= t("form.optional") %>)</span></label>
          <%= f.input :prep_method,
                      as: :text,
                      wrapper: false,
                      label: false,
                      input_html: { rows: 2, class: 'form-control' } %>
        </div>

        <div class="mb-3">
          <label class="form-label"><%= t("form.image") %> <span class="text-muted">(<%= t("form.optional") %>)</span></label>
          <div class="border rounded p-3 text-center bg-light-subtle">
            <% if @ingredient.image.present? %>
              <%= image_tag @ingredient.image.url, alt: "Ingredient Image", class: "img-thumbnail mb-2", style: "max-height: 100px;" %><br>
            <% end %>
            <%= f.file_field :image, class: "form-control form-control-sm" %>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="mb-3">
          <label class="form-label"><%= t("items.volume") %></label>
          <%= f.input :volume,
                      as: :decimal,
                      label: false,
                      input_html: { placeholder: 'e.g., 750', class: 'form-control', min: 1 },
                      wrapper: false %>
        </div>

        <div class="mb-3">
          <label class="form-label"><%= t("items.unit") %></label>
          <%= f.input :unit,
                      as: :select,
                      collection: Unit.select_options,
                      prompt: t("form.select_option"),
                      label: false,
                      input_html: { class: 'form-select' },
                      wrapper: false %>
        </div>

        <div class="mb-3">
          <label class="form-label"><%= t("items.cost") %></label>
          <%= f.input :cost,
                      as: :decimal,
                      label: false,
                      input_html: { placeholder: 'e.g., 25.00', class: 'form-control' },
                      wrapper: false %>
        </div>
      </div>
    </div>
  </div>

  <div class="modal-footer d-flex justify-content-between">
    <button type="button" class="btn btn-light" data-bs-dismiss="modal"><%= t("common.cancel") %></button>
    <div>
      <%= f.button :submit, t("common.save"), class: "btn btn-success me-2" %>
    </div>
  </div>
<% end %>
