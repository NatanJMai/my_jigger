<% @title = t("ingredients.title") %>

<%= render 'layouts/partials/page_title', subtitle: t("ingredients.subtitle"), title: t("ingredients.title") %>

<div class="row">
  <div class="col-12">
    <div class="card" data-table="" data-table-rows-per-page="10">
      <div class="card-header border-light justify-content-between">
        <div class="d-flex gap-2">
          <div class="app-search">
            <input class="form-control" data-table-search="" placeholder="Search ingredient name..." type="search"/>
            <i class="app-search-icon text-muted" data-lucide="search"></i>
          </div>
          <button class="btn btn-danger d-none" data-table-delete-selected="">Delete</button>
        </div>

        <div class="d-flex gap-1">
          <%= link_to new_admin_organization_ingredient_path(@organization),
                      data: { modal: "ingredientModal" },
                      class: "btn btn-primary" do %>
            Add Ingredient
          <% end %>
        </div>
      </div>

      <div class="table-responsive">
        <table class="table table-custom table-centered table-select table-hover w-100 mb-0">
          <thead class="bg-light align-middle bg-opacity-25 thead-sm">
          <tr class="text-uppercase fs-xxs">
            <th class="ps-3" style="width: 1%;">
              <input class="form-check-input form-check-input-light fs-14 mt-0" data-table-select-all="" id="select-all-ingredients" type="checkbox" value="option"/>
            </th>
            <th data-column="name" data-table-sort="name">Name</th>
            <th data-column="volume" data-table-sort="volume">Volume</th>
            <th data-column="unit" data-table-sort="unit">Unit</th>
            <th data-column="cost" data-table-sort="cost">Cost ($)</th>
            <th data-column="updated_at" data-table-sort="updated_at">Updated</th>
            <th class="text-center" style="width: 1%;">Actions</th>
          </tr>
          </thead>
          <tbody id="ingredient-list">
          <%= render partial: 'ingredient', collection: ingredients, as: :ingredient %>
          </tbody>
        </table>
      </div>

      <div class="card-footer border-0">
        <div class="d-flex justify-content-between align-items-center">
          <div data-table-pagination-info="ingredients"></div>
          <div data-table-pagination=""></div>
          <div class="d-flex align-items-center gap-2">
            <div>
              <select class="form-select form-control my-1 my-md-0" data-table-set-rows-per-page="">
                <option value="10">10</option>
                <option value="15">15</option>
                <option value="20">20</option>
                <option value="30">30</option>
              </select>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="ingredientModal" tabindex="-1" aria-labelledby="ingredientModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content" id="ingredient-modal-content">
      <!-- Content loads here -->
    </div>
  </div>
</div>


<% content_for :javascript do %>
  <%= vite_javascript_tag 'js/pages/custom-table.js' %>
<% end %>