<div class="row">
  <div class="col-12">
    <div class="container jigger-form">
      <div class="container-fluid p-0">
        <h5>Ingredient List</h5>

        <div class="row">
          <table class="table table-hover">
            <thead>
            <tr>
              <th scope="col">#</th>
              <th scope="col">Name</th>
              <th class="col-2">Volume</th>
              <th class="col-1">Unit</th>
              <th class="col-1" scope="col">Cost ($)</th>
              <th class="minimal"></th>
            </tr>
            </thead>
            <tbody>
            <% ingredients.order(:name).each do |ingredient| %>
              <%= render partial: 'ingredient', locals: { ingredient: ingredient } %>
            <% end %>
            </tbody>
          </table>
        </div>

        <%= button_to 'Add ingredient', new_admin_organization_ingredient_path(current_organization),
                      class: "btn btn-light shadow-sm px-4 mb-2",
                      :method => :get %>
      </div>
    </div>
  </div>
</div>
