<tr id="<%= dom_id(datasheet_line) %>" class="datasheet_line_row">
  <td><%= datasheet_line.id %></td>
  <td><%= datasheet_line.ingredient.name %></td>
  <td><%= datasheet_line.volume %></td>
  <td><%= datasheet_line.unit %></td>
  <td><%= humanized_money_with_symbol datasheet_line.cost %></td>

  <td>
    <%= number_field_tag "datasheet_line[quantity]", datasheet_line.quantity,
                         class: 'form-control form-control-sm quantity-inline-edit-js',
                         data: {
                           datasheet_line_id: datasheet_line.id,
                           # THIS PATH HELPER IS CRUCIAL
                           # It correctly points to the update action for the specific datasheet_line
                           url: admin_datasheet_line_path(datasheet_line)
                         } %>
  </td>

  <td class="calculated-price-js"><%= humanized_money_with_symbol Money.new(datasheet_line.calculated_price) %></td>
  <td class="text-center">
    <div class="d-flex justify-content-center gap-1">
      <%= link_to admin_datasheet_line_path(datasheet_line),
                  data: { turbo_method: :delete },
                  class: 'btn btn-default btn-icon btn-sm' do %>

        <i class="ti ti-trash fs-lg"></i>
      <% end %>
    </div>
  </td>
</tr>