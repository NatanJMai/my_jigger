<div id="<%= dom_id(datasheet_line) %>" class="datasheet_line_row">
  <div class="col-1"><%= datasheet_line.id %></div>
  <div class="col-4"><%= datasheet_line.ingredient.name %></div>
  <div class="col-1"><%= datasheet_line.volume %></div>
  <div class="col-1"><%= datasheet_line.unit %></div>
  <div class="col-1"><%#= number_to_currency(datasheet_line.cost) %></div>
  <div class="col-1"><%= datasheet_line.quantity %></div>
  <div class="col-1 calculated-price-js"><%#= datasheet_line.total_price %></div>
  <div class="col-1">
    <%#= link_to "Remove",
                admin_item_datasheet_datasheet_line_path(@item, @datasheet, datasheet_line),
                data: { turbo_method: :delete, turbo_confirm: "Remove line?" },
                class: "btn btn-sm btn-outline-danger" %>
  </div>
</div>
