<%= turbo_frame_tag datasheet_line do %>
  <div class="row datasheet-row">
    <div class="col-1 datasheet-id-js"><%= datasheet_line.id %></div>
    <div class="col-4 name-js"
         data-ingredient-id="<%= datasheet_line.ingredient_id %>"
         data-url="<%= details_admin_ingredient_path(datasheet_line.ingredient_id) if datasheet_line.ingredient_id %>"
         data-org-id="<%= datasheet.item.organization_id %>">
      <%= datasheet_line&.display_name %>
    </div>
    <div class="col-1"><%= datasheet_line&.volume %></div>
    <div class="col-1"><%= datasheet_line&.unit %></div>
    <div class="col-1"><%= humanized_money_with_symbol datasheet_line&.cost %></div>
    <div class="col-1"><%= datasheet_line.show_quantity %></div>
    <div class="col-1"><%= humanized_money_with_symbol Money.new datasheet_line.calculated_price %></div>

    <div class="col-1">
      <%= button_to admin_datasheet_line_path(datasheet_line),
                    method: :delete, data: { confirm: "Are you sure you want to delete this line?" },
                    class: "trash-icon-button" do %>

        <i class="fas fa-trash-alt"></i> <!-- Font Awesome Trash Icon -->
      <% end %>
    </div>
  </div>
<% end %>
