<%= turbo_frame_tag "new_form" do %>
  <%= simple_form_for([:admin, @item, @datasheet, @datasheet_line],
                      url: admin_item_datasheet_datasheet_lines_path(@item)) do |f| %>

    <div class="row datasheet_line_row">
      <div class="col-1">
        <%= datasheet_line&.id.presence || "ID" %>
      </div>

      <div class="col-4">
        <%= f.input :ingredient_id, as: :select,
                    input_html: {
                      class: 'ingredient-js',
                      data: { url: find_admin_organization_ingredients_path(@organization) } },
                    collection: Ingredient.all, label: false %>
      </div>

      <div class="col-1">
        <%= f.input :volume, input_html: { class: 'volume-js',
                                           data: {
                                             url: calculate_admin_organization_ingredients_path(@organization)
                                           }
        }, label: false %>
      </div>

      <div class="col-1">
        <%= f.input :unit, as: :select,
                    input_html: { class: 'unit-js' },
                    collection: Unit.select_options, label: false %>
      </div>

      <div class="col-1">
        <%= f.input :cost, input_html: { class: 'cost-cents-js',
                                         data: {
                                           url: calculate_admin_organization_ingredients_path(@organization)
                                         }
        }, label: false %>
      </div>

      <div class="col-1">
        <%= f.input :quantity, input_html: { class: 'quantity-js',
                                             data: {
                                               url: calculate_admin_organization_ingredients_path(@organization)
                                             }
        }, label: false %>
      </div>

      <div class="col-1 calculated-price-js"></div>

      <div class="col-1">
        <%= f.button :submit, "Save", class: "btn btn-success" %>
      </div>
    </div>
  <% end %>
<% end %>
