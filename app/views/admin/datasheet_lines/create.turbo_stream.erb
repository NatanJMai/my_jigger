<%= turbo_stream.append "datasheet_lines_list" do %>
  <%= render 'line', datasheet_line: @datasheet_line %>
<% end %>

<%= turbo_stream.update "new_datasheet_line", "" %>

<%= turbo_stream.replace "totals" do %>
  <%= render partial: 'admin/datasheet_lines/totals',
             locals: {
               datasheet: @datasheet_line.datasheet,
               item: @datasheet_line.datasheet.item
             } %>
<% end %>