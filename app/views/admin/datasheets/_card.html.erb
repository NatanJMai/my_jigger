<div class="row item-title">
  <div class="col-2">
    <i class="fa-solid fa-martini-glass"></i>
  </div>
  <div class="col-9">
    <%= line&.display_name %>
  </div>
</div>

<div class="row">
  <div class="col-12 card-header item-content">
    <div class="row jigger-label">
      <div class="col-6 align-left info-description">
        <%= humanized_money_with_symbol line&.cost %>
      </div>
      <div class="col-6 align-right info-label">Price ($)</div>
    </div>

    <div class="row jigger-label">
      <div class="col-6 align-left info-description">
        <%= line&.display_volume %>
      </div>
      <div class="col-6 align-right info-label">Volume</div>
    </div>

    <div class="row jigger-label">
      <div class="col-6 align-left info-description">
        <%= line&.display_volume %>
      </div>
      <div class="col-6 align-right info-label">Best Before</div>
    </div>

    <div class="item-description">
      <div class="row jigger-label">
        <div class="align-center info-label">Prep Method</div>
      </div>
      <div class="text-center info-label"><%= line&.display_prep_method %></div>
    </div>
  </div>
</div>
