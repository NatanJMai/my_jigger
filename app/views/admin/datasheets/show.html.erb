<% @title = "Datasheet - #{@item.name}" %>

<%= render 'layouts/partials/page_title', subtitle: "Datasheet", title: @item.name %>

<div class="row">
  <div class="col-12">
    <div class="card shadow-sm">

      <%# Card Header from template, adapted for datasheet %>
      <div class="card-header justify-content-between d-flex align-items-center border-light">
        <h4 class="card-title m-0">
          <i class="ti ti-notebook me-2 text-primary"></i>
          Ingredient List & Costs
        </h4>
        <%= link_to 'Back to Item', admin_item_path(@item), class: 'btn btn-sm btn-light' %>
      </div>

      <%# Card Body from template, adapted for datasheet %>
      <div class="card-body">
        <p class="text-muted">
          This table displays all ingredients and their costs associated with this item.
        </p>

        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead class="align-middle thead-sm bg-light bg-opacity-25">
            <tr class="text-uppercase fs-xxs">
              <th style="width: 5%;">ID</th>
              <th style="width: 30%;">Ingredient Name</th>
              <th style="width: 5%;" data-table-sort="volume">Volume</th>
              <th style="width: 5%;">Unit</th>
              <th style="width: 10%;" data-table-sort="cost">Cost</th>
              <th style="width: 5%;">Quantity</th>
              <th style="width: 15%;" data-table-sort="calculated_price">Calculated Price</th>
              <th style="width: 10%;" class="text-center">Actions</th>
            </tr>
            </thead>
            <tbody id="datasheet_lines_list" class="table-group-divider">
              <%= render partial: 'admin/datasheet_lines/line', collection: datasheet_lines, as: :datasheet_line %>
            </tbody>
          </table>
        </div>

        <div class="mt-2">
          <%= turbo_frame_tag "new_datasheet_line" %>
        </div>

        <div class="mt-3">
          <%= link_to new_admin_item_datasheet_datasheet_line_path(@item),
                                      data: { turbo_frame: "new_datasheet_line" },
                                      class: "btn btn-primary" do %>
            <i data-lucide="plus" class="me-2"></i>
            Add Ingredient Line
          <% end %>
        </div>
      </div>

      <div class="card-footer border-light d-flex justify-content-between align-items-start p-3">
        <div><%# Reserved for future elements like save status or history link %></div>
        <div class="d-flex flex-column align-items-end">
          <div class="datasheet-cmv-info card bg-warning-subtle shadow-sm border border-warning">
            <div class="card-body p-2">
              <div class="fw-bold text-warning-emphasis d-flex align-items-center justify-content-end mb-1">
                <i class="ti ti-alert-triangle me-2 fs-5"></i>
                CMV & Price Information
              </div>
              <%= render partial: 'admin/datasheet_lines/totals', locals: { datasheet: datasheet, item: @item } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>


