<% @title = "Import Details - #{@import_job.file.filename}" %>

<%= render 'layouts/partials/page_title', subtitle: "Data Management", title: "Import Details" %>

<div class="row">
  <div class="col-12">
    <div class="card mb-4">
      <div class="card-body">
        <div class="row g-4">
          <div class="col-md-3">
            <h6 class="text-muted text-uppercase fs-xs mb-1">File Name</h6>
            <p class="fw-medium mb-0"><%= @import_job.file.filename %></p>
          </div>
          <div class="col-md-3">
            <h6 class="text-muted text-uppercase fs-xs mb-1">File Size</h6>
            <p class="fw-medium mb-0"><%= number_to_human_size(@import_job.file.blob.byte_size) %></p>
          </div>
          <div class="col-md-3">
            <h6 class="text-muted text-uppercase fs-xs mb-1">Import Type</h6>
            <p class="fw-medium mb-0">
              <span class="badge bg-secondary-subtle text-secondary">
                <%= @import_job.staging_tables.first&.staging_table&.capitalize || 'Order' %>
              </span>
            </p>
          </div>
          <div class="col-md-3">
            <h6 class="text-muted text-uppercase fs-xs mb-1">Status</h6>
            <p class="fw-medium mb-0">
              <% case @import_job.import_status %>
              <% when 'completed' %>
                <span class="badge bg-success-subtle text-success">
                  <i class="ti ti-check me-1"></i>Completed
                </span>
              <% when 'failed' %>
                <span class="badge bg-danger-subtle text-danger">
                  <i class="ti ti-x me-1"></i>Failed
                </span>
              <% when 'in_progress' %>
                <span class="badge bg-warning-subtle text-warning">
                  <i class="ti ti-loader me-1"></i>In Progress
                </span>
              <% else %>
                <span class="badge bg-secondary-subtle text-secondary">
                  <%= @import_job.import_status || 'Pending' %>
                </span>
              <% end %>
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header bg-white">
        <h5 class="card-title mb-0">
          <i class="ti ti-list me-2"></i>Imported Records
        </h5>
      </div>
      <% if @import_job.staging_tables.any? %>
        <div class="table-responsive">
          <table class="table table-custom table-centered table-hover w-100 mb-0">
            <thead class="bg-light align-middle bg-opacity-25 thead-sm">
              <tr class="text-uppercase fs-xxs">
                <th class="ps-3">Row</th>
                <th>Field</th>
                <th>Value</th>
                <th>Type</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% @import_job.staging_tables.order(:object_number).each do |staging| %>
                <tr>
                  <td class="ps-3"><%= staging.object_number %></td>
                  <td><%= staging.attribute_name %></td>
                  <td><%= staging.row_data %></td>
                  <td><span class="badge bg-secondary-subtle text-secondary"><%= staging.data_type %></span></td>
                  <td>
                    <% if staging.staging_status == 'completed' %>
                      <span class="badge bg-success-subtle text-success">OK</span>
                    <% elsif staging.staging_status == 'failed' %>
                      <span class="badge bg-danger-subtle text-danger">Error</span>
                    <% else %>
                      <span class="badge bg-warning-subtle text-warning">Pending</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="card-body text-center py-5">
          <i class="ti ti-inbox fs-2xl text-muted mb-3"></i>
          <p class="text-muted">No records found for this import</p>
        </div>
      <% end %>
    </div>

    <div class="mt-3">
      <%= link_to admin_organization_import_jobs_path(@organization), class: 'btn btn-light' do %>
        <i class="ti ti-arrow-left me-1"></i> Back to Import History
      <% end %>
    </div>
  </div>
</div>