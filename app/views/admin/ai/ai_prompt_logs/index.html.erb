<div class="row">
  <div class="col-12">
    <div class="container jigger-form">
      <div class="container-fluid p-0">
        <h5>AI Prompt Logs</h5>

        <div class="row">
          <table class="table table-hover">
            <thead>
            <tr>
              <th scope="col">#</th>
              <th class="col-2">Prompt Type</th>
              <th class="col-1">Date</th>
              <th class="col-1">Success</th>
              <th class="col-1">Response</th>
              <th class="col-6">Prompt Text</th>
              <th class="minimal"></th>
            </tr>
            </thead>
            <tbody>
              <%= render partial: 'ai_prompt_log', collection: ai_prompt_logs, as: :ai_prompt_log %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
