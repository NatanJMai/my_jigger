<div class="container jigger-form">
  <%= simple_form_for(model,
                      html: { class: 'row row-cols' } ) do |f| %>

    <%= render partial: 'layouts/shared/form/header',
               locals: { title: 'Add/Save Category',
                         subtitle: 'Category details' } %>

    <div class="row">
      <div class="col-8">
        <div class="row">
          <div class="col-8">
            <%= f.input :name, hint: 'Category name', wrapper_html: { class: 'jigger-label' } %>
          </div>

          <div class="col-4">
            <%= f.input :status, label: 'Status (Active)', hint: 'Is this Category active?',
                        wrapper_html: { class: 'jigger-label' } %>
          </div>
        </div>

        <div class="row">
          <div class="col-12">
            <%= f.input :description, hint: 'Category description (e.g where it is from)',
                        wrapper_html: { class: 'jigger-label' } %>
          </div>
        </div>

        <div class="row">
          <div class="col-3">
            <%= f.button :submit, "Add/Save Category", class: "form-btn"  %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="col-4">
      <div class="vertical-line">
        <%= render partial: 'admin/menus/organization_info', locals: { organization: @organization } %>
      </div>
    </div>
  </div>
</div>

