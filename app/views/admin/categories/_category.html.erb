<tr id="<%= dom_id(category) %>" data-id="<%= category.id %>">

  <td class="ps-3">
    <input class="form-check-input form-check-input-light fs-14 file-item-check mt-0" type="checkbox" value="<%= category.id %>"/>
  </td>

  <td scope="row"><%= category.id %></td>

  <td>
    <h5 class="m-0">
      <span class="ti ti-folder text-primary fs-lg me-1"></span>
      <a class="link-reset fw-semibold">
        <%= category.name %>
      </a>
    </h5>
  </td>

  <td>
    <%= category.items.best_five.map(&:name).join(', ') %>
  </td>

  <td class="minimal" data-column="status" data-filter-value="<%= category.status.to_s %>">
    <%
      status_text = category.status ? 'Active' : 'Draft/Inactive'
      status_class = category.status ? 'success' : 'danger'
    %>
    <span class="badge badge-soft-<%= status_class %> fs-xxs"><%= status_text %></span>
  </td>

  <td>
    <div class="d-flex align-items-center justify-content-center gap-1">
      <%= link_to edit_admin_category_path(category),
                  class: "btn btn-default btn-icon btn-sm",
                  data: {
                    modal: "categoryModal"
                  } do %>
        <i class="ti ti-edit fs-lg"></i>
      <% end %>
      <%= button_to admin_category_path(category),
                    method: :delete,
                    data: { confirm: "Are you sure you want to delete this order?" },
                    class: "btn btn-default btn-icon btn-sm" do %>
        <i class="ti ti-trash fs-lg"></i>
      <% end %>
    </div>
  </td>
</tr>
