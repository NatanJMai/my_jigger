<tr>
  <th scope="row"><%= category.id %></th>
  <td><%= category.name %></td>
  <td><%= category.items.best_five.map(&:name).join(', ') %></td>
  <td class="minimal"><%= category.boolean_label(category.status) %></td>
  <td class="minimal">
    <%= link_to edit_admin_category_path(category), class: 'btn', title: 'Edit Category' do %>
      <i class="fa-regular fa-pen-to-square edit-button"></i>
    <% end %>

    <%= button_to admin_category_path(category),
                  method: :delete,
                  title: 'Delete Category',
                  class: "trash-icon-button" do %>

      <i class="fas fa-trash-alt"></i> <!-- Font Awesome Trash Icon -->
    <% end %>
  </td>
</tr>
