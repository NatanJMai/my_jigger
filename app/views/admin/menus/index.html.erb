<% @title = "Ingredient List" %>

<%= render 'layouts/partials/page_title', subtitle: "Inventory", title: "Menu Management",
           new_url: new_admin_organization_menu_path(@organization) %>
<div class="row">
  <% menus.each do |menu| %>
    <div class="col-12">
      <%= render 'admin/menus/card', menu: menu, items: menu.items %>
    </div>
  <% end %>
</div>
