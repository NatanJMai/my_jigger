<div class="row card-header">
  <div class="col-7">
    <h4 class="card-title text-left">
      <%= menu.name %>
      <%= link_to edit_admin_menu_path(menu) do %>
        <i class="fa-regular fa-pen-to-square edit-button"></i>
      <% end %>
    </h4>
    <%= menu.released_at %>
  </div>

  <div class="col-5">
    <div class="row">
      <div class="col-5">
        <%= menu.boolean_label(menu.status) %>
      </div>
      <div class="col-5">
        <%= menu.boolean_label(menu.data_imported,
                               label = { true => 'Data Imported',
                                         false => 'Not Imported' }) %>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-12">
    <div class="row jigger-label">
      <div class="align-center info-label menu-description"><%= menu.description %></div>
    </div>
  </div>
</div>

<div class="item-table">
  <div class="col-12">
    <div class="row jigger-label">
      <div class="col-12 align-left info-description">
        <%= render partial: 'admin/menus/partials/best_five' %>
      </div>
    </div>
  </div>
</div>