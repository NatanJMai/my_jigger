<div class="col-xl-3">
  <div class="card card-top-sticky">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-center rounded border-light p-2 bg-light-subtle border">
        <div class="d-flex justify-content-start align-items-center gap-3">
          <div class="avatar avatar-xl">
            <% if menu.organization.image.present? %>
              <%= image_tag menu.organization.image.url, alt: "organization-image", class: "img-fluid rounded-circle" %>
            <% else %>
              <div class="img-fluid rounded-circle bg-primary d-flex align-items-center justify-content-center text-white fw-bold" style="width: 50px; height: 50px; font-size: 24px;">
                <%= menu.organization.name[0..1].upcase %>
              </div>
            <% end %>
          </div>
          <div>
            <h5 class="text-nowrap fw-bold mb-1"><%= menu.name %></h5>
            <p class="text-muted mb-0"><%= menu.release_date&.strftime('%B %d, %Y') if menu.release_date %></p>
          </div>
        </div>
        <%# Edit Button %>
        <div class="d-flex gap-2">
          <%= link_to edit_admin_menu_path(menu), class: "btn btn-sm btn-icon btn-light" do %>
            <i class="ti ti-pencil fs-20"></i>
          <% end %>
        </div>
      </div>
      <div class="mt-3">
        <% if menu.organization.manager.present? %>
          <div class="d-flex align-items-center gap-2 mb-2">
            <div class="avatar-sm text-bg-light d-flex align-items-center justify-content-center rounded">
              <i class="ti ti-user fs-xl"></i>
            </div>
            <p class="mb-0 fs-sm">Owner: <span class="fw-semibold"><%= menu.organization.manager.display_name %></span></p>
          </div>
        <% end %>
        <% if menu.organization.created_at.present? %>
          <div class="d-flex align-items-center gap-2 mb-2">
            <div class="avatar-sm bg-light d-flex align-items-center justify-content-center rounded">
              <i class="ti ti-calendar-event fs-xl"></i>
            </div>
            <p class="mb-0 fs-sm">Founded: <span class="fw-semibold"><%= menu.organization.created_at.year %></span></p>
          </div>
        <% end %>
        <% if menu.organization.address.present? %>
          <div class="d-flex align-items-center gap-2 mb-2">
            <div class="avatar-sm bg-light d-flex align-items-center justify-content-center rounded">
              <i class="ti ti-map-pin fs-xl"></i>
            </div>
            <p class="mb-0 fs-sm">Location: <span class="fw-semibold"><%= menu.organization.address %></span></p>
          </div>
        <% end %>
        <% if menu.organization.email.present? %>
          <div class="d-flex align-items-center gap-2 mb-2">
            <div class="avatar-sm bg-light d-flex align-items-center justify-content-center rounded">
              <i class="ti ti-mail fs-xl"></i>
            </div>
            <p class="mb-0 fs-sm">Email: 
              <a class="text-primary fw-semibold" href="mailto:<%= menu.organization.email %>"><%= menu.organization.email %></a>
            </p>
          </div>
        <% end %>
        <% if menu.organization.site.present? %>
          <div class="d-flex align-items-center gap-2 mb-2">
            <div class="avatar-sm bg-light d-flex align-items-center justify-content-center rounded">
              <i class="ti ti-link fs-xl"></i>
            </div>
            <p class="mb-0 fs-sm">Website:
              <% website_url = menu.organization.site.start_with?('http') ? menu.organization.site : "https://#{menu.organization.site}" %>
              <a class="text-primary fw-semibold" href="<%= website_url %>" target="_blank" rel="noopener noreferrer"><%= menu.organization.site %></a>
            </p>
          </div>
        <% end %>
        <% if menu.organization.phone.present? %>
          <div class="d-flex align-items-center gap-2 mb-2">
            <div class="avatar-sm bg-light d-flex align-items-center justify-content-center rounded">
              <i class="ti ti-phone fs-xl"></i>
            </div>
            <p class="mb-0 fs-sm">Phone: 
              <a class="text-primary fw-semibold" href="tel:<%= menu.organization.phone %>"><%= menu.organization.phone %></a>
            </p>
          </div>
        <% end %>
      </div>
    </div>
    <div class="card-body border-top border-dashed">
      <div class="border-light">
        <h6 class="text-muted text-uppercase fs-xs mb-2">Description:</h6>
        <p class="fs-sm text-break"><%= menu.description || "No description provided for this menu." %></p>
      </div>
    </div>
  </div> <!-- end card-->
</div> <!-- end col-->