<div class="tab-pane fade" id="tab7" role="tabpanel" aria-labelledby="tab7-tab">
  <div class="card">
    <div class="card-header border-light">
      <h4 class="card-title text-center mb-0">AI Assistant</h4>
    </div>

    <div class="card-body">
      <div class="row mb-5">
        <div class="col-lg-8 offset-lg-2 text-center">

          <p class="fs-5 text-muted">
            The **AI Assistant** analyzes your menu data to offer
            personalized recommendations, highlight improvement opportunities,
            and help you make smarter decisions for **improving profitability**.
          </p>
          <p class="fs-6 fw-semibold mb-3">
            Leverage AI to uncover profit gaps, reduce waste, and transform your menu into a strategic growth tool.
          </p>

          <%= link_to "Analyze Menu", admin_menu_ai_assistant_analyze_path(@menu),
                      data: { turbo_method: :post, turbo_stream: true },
                      class: "btn btn-primary btn-ai-assistant shadow-sm px-4" %>
        </div>
      </div>

      <div class="ai-content row g-4">
        <div class="col-xl-3">
          <div class="card h-100 bg-light-subtle shadow-sm border border-light">
            <div class="card-header bg-transparent border-bottom border-light">
              <h6 class="mb-0 fw-bold">Recommendation Topics</h6>
            </div>
            <div class="card-body d-flex flex-column gap-2">
              <% @recommendation_topics.each do |rec_topic| %>
                <div>
                  <%= link_to "#{rec_topic.name}",
                              by_topic_admin_organization_ai_ai_prompt_logs_path(@organization, ai_recommendation_topic_id: rec_topic.id),
                              class: 'btn btn-outline-secondary w-100 text-start shadow-sm',
                              data: { turbo_method: :get, turbo_stream: true } %>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <div class="col-xl-9">
          <div class="card h-100">
            <div class="card-header">
              <h6 class="card-title mb-0 fw-bold">Recent Recommendations</h6>
            </div>
            <div class="card-body p-0">
              <%= render partial: 'admin/ai/ai_recommendations/table', locals: { ai_prompt_logs: ai_prompt_logs, topic_id: nil } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>