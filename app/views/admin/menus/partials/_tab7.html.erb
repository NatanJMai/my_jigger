<div class="tab-pane fade" id="tab7" role="tabpanel" aria-labelledby="tab7-tab">
  <div class="row">
    <div class="col-12">
      <div class="container jigger-form">
        <div class="row">
          <div class="col-12">
            <div class="card-header">
              <div class="col-12">
                <h4 class="card-title text-center">AI Assistant</h4>
              </div>
            </div>
          </div>
        </div>

        <div class="row">
          <div class="col-12">
            <div class="container text-center ai-assistant-description">
              <p>
                <strong>AI Assistant</strong> analyzes your menu data to deliver
                personalized recommendations, highlight improvement opportunities,
                and help you make smarter decisions for better profitability.
              </p>
              <p>
                <strong>Leverage AI</strong> to uncover profit gaps, reduce waste,
                and turn your menu into a strategic growth tool.
              </p>
            </div>
          </div>
        </div>

        <div class="row">
          <div class="col-12">
            <div class="container text-center">
              <%= link_to "Analyze Menu", admin_menu_ai_assistant_analyze_path(@menu),
                          data: { turbo_method: :post, turbo_stream: true },
                          class: "btn btn-blue btn-ai-assistant shadow-sm px-4 mb-2" %>

              <%#= link_to 'Analyse Menu', cost_analysis_admin_menu_path(@menu),
                          class: "btn btn-blue btn-ai-assistant shadow-sm px-4 mb-2" %>
            </div>
          </div>
        </div>

        <div class="ai-content">
          <div class="row">
            <div class="col-4 ai-content-topics">
              <h6><b>Recommendation Topics</b></h6>
              <div class="container jigger-form child-list">
                <% @recommendation_topics.each do |rec_topic| %>
                  <div>
                    <%= link_to "#{rec_topic.name}",
                                   by_topic_admin_organization_ai_ai_prompt_logs_path(@organization, ai_recommendation_topic_id: rec_topic.id),
                                class: 'btn btn-light ai-topics shadow-sm px-4 mb-2',
                                data: { turbo_method: :get, turbo_stream: true } %>
                  </div>
                <% end %>
              </div>
            </div>

            <div class="col-8 ai-content-recommendations">
              <div class="row">
                <div class="col-12">
                  <%= render partial: 'admin/ai/ai_recommendations/table', locals: { ai_prompt_logs: ai_prompt_logs } %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>