<div class="tab-pane fade" id="tab4" role="tabpanel" aria-labelledby="tab4-tab">
  <div class="row g-3">
    <div class="col-xl-8">
      <div class="card h-100">
        <div class="card-header bg-white">
          <h4 class="card-title mb-0">
            <i class="ti ti-chart-scatter me-2"></i>Menu Engineering Matrix
          </h4>
        </div>
        <div class="card-body">
          <div class="matrix-chart">
            <div>
              <div class="row row-left-square">
                <div class="col-1">
                  <div class="line-with-arrow top">
                    <span class="label">Popularity →</span>
                  </div>
                </div>

                <div class="col-5">
                  <div class="row-square red">
                    <div class="square-container">
                      <h4>🚀 Plowhorses</h4>
                      <small class="text-muted">High sales, low profit</small>
                    </div>

                    <div class="items-container">
                      <% (@plow_horses || []).each_with_index do |item, index| %>
                        <%= render partial: 'admin/menus/partials/matrix/item',
                                   locals: { item: item, index: index } %>
                      <% end %>
                      <% if (@plow_horses || []).empty? %>
                        <p class="text-muted small p-3">No plow horses found</p>
                      <% end %>
                    </div>
                  </div>

                  <div class="row-square purple">
                    <div class="square-container">
                      <h4>💀 Dogs</h4>
                      <small class="text-muted">Low sales, low profit</small>
                    </div>

                    <div class="items-container">
                      <% (@dogs || []).each_with_index do |item, index| %>
                        <%= render partial: 'admin/menus/partials/matrix/item',
                                   locals: { item: item, index: index } %>
                      <% end %>
                      <% if (@dogs || []).empty? %>
                        <p class="text-muted small p-3">No dogs found - great!</p>
                      <% end %>
                    </div>
                  </div>
                </div>

                <div class="col-5">
                  <div class="row-square blue">
                    <div class="square-container">
                      <h4>🌟 Stars</h4>
                      <small class="text-muted">High sales, high profit</small>
                    </div>

                    <div class="items-container">
                      <% (@stars || []).each_with_index do |item, index| %>
                        <%= render partial: 'admin/menus/partials/matrix/item',
                                   locals: { item: item, index: index } %>
                      <% end %>
                      <% if (@stars || []).empty? %>
                        <p class="text-muted small p-3">No stars yet</p>
                      <% end %>
                    </div>
                  </div>

                  <div class="row-square orange">
                    <div class="square-container">
                      <h4>🧩 Puzzles</h4>
                      <small class="text-muted">Low sales, high profit</small>
                    </div>

                    <div class="items-container">
                      <% (@puzzles || []).each_with_index do |item, index| %>
                        <%= render partial: 'admin/menus/partials/matrix/item',
                                   locals: { item: item, index: index } %>
                      <% end %>
                      <% if (@puzzles || []).empty? %>
                        <p class="text-muted small p-3">No puzzles found</p>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="line-with-arrow right">
              <span class="label">Profitability →</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-xl-4">
      <div class="card h-100">
        <div class="card-header bg-white">
          <h4 class="card-title mb-0">Matrix Insights</h4>
        </div>
        <div class="card-body">
          <%= render partial: 'admin/menus/partials/matrix/matrix_description' %>
        </div>
      </div>
    </div>
  </div>
</div>