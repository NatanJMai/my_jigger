<div>
  <div class="row row-left-square <%= insight_screen %>">
    <div class="col-1">
      <div class="line-with-arrow top">
        <span class="label">Popularity</span>
      </div>
    </div>

    <div class="col-5 <%= custom_col %>">
      <div class="row row-square red">
        <div class="col-12">
          <div class="square-container">
            <h4>Plowhorses</h4>
          </div>

          <div class="items-container">
            <% plow_horses = matrix_tab ? @plow_horses : @plow_horses.limit(2) %>
            <% plow_horses.each_with_index do |item, index| %>
              <%= render partial: 'admin/menus/partials/matrix/item',
                         locals: { icon: '🚀', item: item, index: index } %>
            <% end %>
          </div>

          <% if custom_col && plow_horses.any? %>
            <div class="view-all">view all..</div>
          <% end %>
        </div>
      </div>

      <div class="row row-square purple">
        <div class="col-12">
          <div class="square-container">
            <h4>Dogs</h4>
          </div>

          <div class="items-container">
            <% dogs = matrix_tab ? @dogs : @dogs.limit(2) %>
            <% dogs.each_with_index do |item, index| %>
              <%= render partial: 'admin/menus/partials/matrix/item',
                         locals: { icon: '💀', item: item, index: index } %>
            <% end %>
          </div>

          <% if custom_col && dogs.any? %>
            <div class="view-all">view all..</div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-5 <%= custom_col %>">
      <div class="row row-square blue">
        <div class="col-12">
          <div class="square-container">
            <h4>Stars</h4>
          </div>

          <div class="items-container">
            <% stars = matrix_tab ? @stars : @stars.limit(2) %>
            <% stars.each_with_index do |item, index| %>
              <%= render partial: 'admin/menus/partials/matrix/item',
                         locals: { icon: '🌟', item: item, index: index } %>
            <% end %>
          </div>

          <% if custom_col && stars.any? %>
            <div class="view-all">view all..</div>
          <% end %>
        </div>
      </div>

      <div class="row row-square orange">
        <div class="col-12">
          <div class="square-container">
            <h4>Puzzles</h4>
          </div>

          <div class="items-container">
            <% puzzles = matrix_tab ? @puzzles : @puzzles.limit(2) %>
            <% puzzles.each_with_index do |item, index| %>
              <%= render partial: 'admin/menus/partials/matrix/item',
                         locals: { icon: '📉', item: item, index: index } %>
            <% end %>
          </div>

          <% if custom_col && puzzles.any? %>
            <div class="view-all">view all..</div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="line-with-arrow right">
  <span class="label">Profitability</span>
</div>