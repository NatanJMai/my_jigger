<div>
  <div class="row row-left-square <%= insight_screen if defined? (insight_screen) %>">
    <div class="col-1">
      <div class="line-with-arrow top">
        <span class="label">Right Arrow</span>
      </div>
    </div>

    <div class="col-4 <%= menu_screen if defined? menu_screen %>">
      <div class="row row-square red">
        <div class="col-12">
          <div class="square-container">
            <h4>Plowhorses</h4>
          </div>
        </div>
      </div>

      <div class="row row-square blue">
        <div class="col-12 <%= menu_screen if defined? menu_screen %>">
          <div class="square-container">
            <h4>Stars</h4>
          </div>
        </div>
      </div>
    </div>

    <div class="col-4 <%= menu_screen if defined? menu_screen %>">
      <div class="row row-square purple">
        <div class="col-12">
          <div class="square-container">
            <h4>Dogs</h4>
          </div>
        </div>
      </div>

      <div class="row row-square orange">
        <div class="col-12 <%= menu_screen if defined? menu_screen %>">
          <div class="square-container">
            <h4>Puzzles</h4>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="line-with-arrow right">
  <span class="label">Right Arrow</span>
</div>