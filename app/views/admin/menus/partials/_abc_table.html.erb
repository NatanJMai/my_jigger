<div class="table-responsive">
  <table class="table table-custom table-centered table-select table-hover w-100 mb-0 abc-table">
    <thead class="bg-light align-middle bg-opacity-25 thead-sm">
    <tr class="text-uppercase fs-xxs">
      <th class="ps-3" data-table-sort="item">Item</th>
      <th data-table-sort="category">Category</th>
      <th data-table-sort="sales">Sales (BRL)</th>
      <th data-table-sort="abc">ABC</th>
    </tr>
    </thead>

    <tbody id="abc-table-list">
    <% items.sort_by { |item| -item.total_value }.each do |item| %>
      <%
        abc_class = case item.abc_category
                    when 'A' then 'table-success'
                    when 'B' then 'table-warning'
                    when 'C' then 'table-danger'
                    else ''
                    end
      %>
      <tr class="<%= abc_class %>">
        <td class="ps-3 fw-medium"><%= item.name %></td>
        <td><%= item.category&.decorate&.name || '-' %></td>
        <td><%= humanized_money_with_symbol Money.new(item.total_orders(attribute: :total_amount_cents)) %></td>
        <td>
          <span class="badge fs-sm bg-<%= item.abc_category == 'A' ? 'success' : item.abc_category == 'B' ? 'warning' : 'danger' %>-subtle text-<%= item.abc_category == 'A' ? 'success' : item.abc_category == 'B' ? 'warning' : 'danger' %>">
            <%= item.abc_category || '-' %>
          </span>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
</div>

<div class="card-footer border-0">
  <div class="row g-3">
    <div class="col-md-4">
      <div class="d-flex align-items-center">
        <span class="badge bg-success-subtle text-success me-2">A</span>
        <small class="text-muted">Top 70% revenue (focus items)</small>
      </div>
    </div>
    <div class="col-md-4">
      <div class="d-flex align-items-center">
        <span class="badge bg-warning-subtle text-warning me-2">B</span>
        <small class="text-muted">Next 20% revenue (supporting)</small>
      </div>
    </div>
    <div class="col-md-4">
      <div class="d-flex align-items-center">
        <span class="badge bg-danger-subtle text-danger me-2">C</span>
        <small class="text-muted">Bottom 10% revenue (low impact)</small>
      </div>
    </div>
  </div>
</div>