<div class="tab-pane fade show active" id="tab1" role="tabpanel" aria-labelledby="tab1-tab">
  <div class="row">
    <%= render partial: 'admin/menus/partials/menu_info' %>

    <div class="col-xl-9">
      <%# ===================== KPI CARDS ===================== %>
      <div class="row row-cols-xxl-4 row-cols-md-2 row-cols-1 g-3 align-items-center">
        <div class="col">
          <div class="card">
            <div class="card-body">
              <div class="d-flex justify-content-between">
                <h5 title="Number of Orders">Orders</h5>
                <p class="mb-0 fs-lg"><i class="ti ti-shopping-cart text-muted"></i></p>
              </div>
              <div class="d-flex align-items-center gap-2 my-2">
                <div class="avatar-md flex-shrink-0">
                  <span class="avatar-title text-bg-success bg-opacity-90 rounded-circle fs-22">
                    <i class="ti ti-shopping-cart"></i>
                  </span>
                </div>
                <h3 class="mb-0"><%= menu.total_item_orders(:quantity) %></h3>
              </div>
              <p class="mb-0">
                <span class="text-success"><i class="ti ti-point-filled"></i></span>
                <span class="text-nowrap text-muted">Items sold</span>
              </p>
            </div>
          </div>
        </div>
        <div class="col">
          <div class="card">
            <div class="card-body">
              <div class="d-flex justify-content-between">
                <h5 title="Revenue Earned">Revenue</h5>
                <p class="mb-0 fs-lg"><i class="ti ti-currency-dollar text-muted"></i></p>
              </div>
              <div class="d-flex align-items-center gap-2 my-2">
                <div class="avatar-md flex-shrink-0">
                  <span class="avatar-title text-bg-warning bg-opacity-90 rounded-circle fs-22">
                    <i class="ti ti-currency-dollar"></i>
                  </span>
                </div>

                <%
                  start_date = 11.months.ago.beginning_of_month
                  end_date = Time.zone.now.end_of_day
                  twelve_month_revenue = @menu.total_item_orders(:total_amount_cents, start_date: start_date, end_date: end_date)
                %>

                <h3 class="mb-0"><%= humanized_money_with_symbol Money.new(twelve_month_revenue) %></h3>
              </div>
              <p class="mb-0">
                <span class="text-warning"><i class="ti ti-point-filled"></i></span>
                <span class="text-nowrap text-muted">Total Revenue (BRL)</span>
              </p>
            </div>
          </div>
        </div>
        <div class="col">
          <div class="card">
            <div class="card-body">
              <div class="d-flex justify-content-between">
                <h5 title="Top Selling Item">Top Item</h5>
                <p class="mb-0 fs-lg"><i class="ti ti-star text-muted"></i></p>
              </div>
              <div class="d-flex align-items-center gap-2 my-2">
                <div class="avatar-md flex-shrink-0">
                  <span class="avatar-title text-bg-info bg-opacity-90 rounded-circle fs-22">
                    <i class="ti ti-star"></i>
                  </span>
                </div>
                <h3 class="mb-0 fs-6"><%#= items.joins(:order_items).group(:item_id).sum('order_items.quantity').max_by { |k, v| v }&.name || 'N/A' %></h3>
              </div>
              <p class="mb-0">
                <span class="text-info"><i class="ti ti-point-filled"></i></span>
                <span class="text-nowrap text-muted">Best seller</span>
              </p>
            </div>
          </div>
        </div>
        <div class="col">
          <div class="card">
            <div class="card-body">
              <div class="d-flex justify-content-between">
                <h5 title="Total Items">Menu Items</h5>
                <p class="mb-0 fs-lg"><i class="ti ti-box text-muted"></i></p>
              </div>
              <div class="d-flex align-items-center gap-2 my-2">
                <div class="avatar-md flex-shrink-0">
                  <span class="avatar-title text-bg-secondary bg-opacity-90 rounded-circle fs-22">
                    <i class="ti ti-box"></i>
                  </span>
                </div>
                <h3 class="mb-0"><%= menu.items.count %></h3>
              </div>
              <p class="mb-0">
                <span class="text-secondary"><i class="ti ti-point-filled"></i></span>
                <span class="text-nowrap text-muted"><%= menu.categories.count %> categories</span>
              </p>
            </div>
          </div>
        </div>
      </div>

      <%# ===================== ROW 1: STACKED BAR + PIE ===================== %>
      <div class="row g-3 mt-2">
        <div class="col-xl-8">
          <div class="card h-100">
            <div class="card-header bg-white">
              <div class="d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">
                  <i class="ti ti-chart-bar me-2"></i>Sales Performance
                </h5>
                <div class="d-flex align-items-center gap-2">
                  <%# Toggle: All / Top 5 %>
                  <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn btn-outline-secondary active" id="salesViewAll">All</button>
                    <button type="button" class="btn btn-outline-secondary" id="salesViewTop5">Top 5</button>
                  </div>
                  <div class="dropdown d-inline-block">
                    <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" id="salesItemsDropdown" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                      <i class="ti ti-filter me-1"></i>Select Items
                    </button>
                    <div class="dropdown-menu dropdown-menu-end p-2" aria-labelledby="salesItemsDropdown" style="min-width: 250px; max-height: 300px; overflow-y: auto;">
                      <div class="form-check mb-2 border-bottom pb-2">
                        <input class="form-check-input" type="checkbox" id="salesSelectAll" checked>
                        <label class="form-check-label fw-semibold" for="salesSelectAll">Select All</label>
                      </div>
                      <% menu.items.each do |item| %>
                        <div class="form-check">
                          <input class="form-check-input sales-item-checkbox" type="checkbox" id="salesItem<%= item.id %>" value="<%= item.id %>" checked>
                          <label class="form-check-label" for="salesItem<%= item.id %>"><%= item.name %></label>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="card-body">
              <div dir="ltr">
                <%# Sales chart container — original IDs preserved for JS compatibility %>
                <div
                  style="height: 350px;"
                  id="menu-sales-container"
                  data-chart-endpoint="<%= sales_performance_by_menu_admin_menu_charts_path(@menu) %>"
                >
                  <canvas id="menu-sales-performance"></canvas>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-xl-4">
          <div class="card h-100">
            <div class="card-header bg-white">
              <div class="d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">
                  <i class="ti ti-chart-pie me-2"></i>Sales by Category
                </h5>
                <div class="dropdown d-inline-block">
                  <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" id="categoryItemsDropdown" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                    <i class="ti ti-filter me-1"></i>Select Items
                  </button>
                  <div class="dropdown-menu dropdown-menu-end p-2" aria-labelledby="categoryItemsDropdown" style="min-width: 250px; max-height: 300px; overflow-y: auto;">
                    <div class="form-check mb-2 border-bottom pb-2">
                      <input class="form-check-input" type="checkbox" id="categorySelectAll" checked>
                      <label class="form-check-label fw-semibold" for="categorySelectAll">Select All</label>
                    </div>
                    <% menu.items.each do |item| %>
                      <div class="form-check">
                        <input class="form-check-input category-item-checkbox" type="checkbox" id="categoryItem<%= item.id %>" value="<%= item.id %>" checked>
                        <label class="form-check-label" for="categoryItem<%= item.id %>"><%= item.name %></label>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
            <div class="card-body">
              <div dir="ltr">
                <div style="height: 320px;" id="menu-categories-container" data-chart-endpoint="<%= sales_performance_by_categories_pie_admin_menu_charts_path(@menu) %>">
                  <canvas id="menu-categories-pie"></canvas>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <%# ===================== ROW 2: HEATMAP ===================== %>
      <div class="row g-3 mt-1">
        <div class="col-12">
          <div class="card">
            <div class="card-header bg-white">
              <div class="d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">
                  <i class="ti ti-layout-grid me-2"></i>Sales Heatmap
                  <span class="badge bg-secondary-subtle text-secondary ms-2 fw-normal fs-12">Daily volume per item</span>
                </h5>
                <span class="text-muted small">Hover a cell for details</span>
              </div>
            </div>
            <div class="card-body">
              <%#
                data-chart-endpoint points to the same weekly sales endpoint.
                The JS will reshape the data into ApexCharts heatmap format.
              %>
              <div
                id="menu-sales-heatmap-container"
                data-chart-endpoint="<%= sales_performance_by_menu_admin_menu_charts_path(@menu) %>"
              >
                <div id="menu-heatmap-loading" class="text-center text-muted p-4">
                  <div class="spinner-border spinner-border-sm me-2" role="status"></div>Loading heatmap…
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <%# ===================== ROW 3: AI FORECAST PANEL ===================== %>
      <div class="row g-3 mt-1">
        <div class="col-12">
          <div class="card">
            <div class="card-header bg-white">
              <div class="d-flex justify-content-between align-items-center">
                <div>
                  <h5 class="card-title mb-0">
                    <i class="ti ti-wand me-2"></i>AI Forecast
                    <span class="badge bg-primary-subtle text-primary ms-2 fw-normal fs-12">Next 30 days · mocked</span>
                  </h5>
                  <p class="text-muted small mb-0 mt-1">Per-item prediction based on recent sales patterns</p>
                </div>
                <button
                  id="generate-forecast-btn"
                  class="btn btn-primary btn-sm"
                  data-chart-endpoint="<%= sales_performance_by_menu_admin_menu_charts_path(@menu) %>"
                >
                  <i class="ti ti-sparkles me-1"></i>Generate Forecast
                </button>
              </div>
            </div>
            <div class="card-body">
              <%# Placeholder shown before forecast is generated %>
              <div id="forecast-placeholder" class="text-center py-5 text-muted border border-dashed rounded">
                <i class="ti ti-chart-dots fs-36 d-block mb-2"></i>
                Click <strong>Generate Forecast</strong> to predict the next 30 days per item
              </div>

              <%# AI insight text, hidden until generated %>
              <div id="forecast-insight" class="alert alert-info d-none mb-3">
                <i class="ti ti-bulb me-2"></i>
                <span id="forecast-insight-text"></span>
              </div>

              <%# Item selector pills, hidden until generated %>
              <div id="forecast-item-selector" class="d-none mb-3 d-flex flex-wrap gap-2">
                <%# Pills injected by JS %>
              </div>

              <%# Per-item detail chart: actual + dashed forecast line %>
              <div id="forecast-detail-container" class="d-none">
                <div style="height: 220px; position: relative;">
                  <canvas id="forecast-detail-canvas"></canvas>
                </div>
              </div>

              <%# Ranked forecast summary bars, hidden until generated %>
              <div id="forecast-ranked-container" class="d-none mt-3">
                <p class="text-muted small mb-2 fw-semibold">Predicted totals — ranked</p>
                <div id="forecast-ranked-list"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <%# ===================== ROW 4: ITEM LIST ===================== %>
      <div class="row mt-3">
        <div class="col-12">
          <div class="card">
            <div class="card-header bg-white">
              <h5 class="card-title mb-0">
                <i class="ti ti-list me-2"></i>Menu Items
              </h5>
            </div>
            <div class="card-body p-0">
              <%= render partial: 'admin/menus/partials/item_list', locals: { items: items } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<% content_for :javascript do %>
  <%= vite_javascript_tag 'js/pages/custom-table.js' %>
  <%= vite_javascript_tag 'js/pages/menu-sales-chart.js' %>
  <%= vite_javascript_tag 'js/pages/menu-heatmap-chart.js' %>
<% end %>
