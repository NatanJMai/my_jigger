<div class="carousel-inner" role="listbox">
  <% best_five.each_with_index do |item, index| %>
    <div class="carousel-item <%= 'active' if index.zero? %>">
      <!-- first slide  -->
      <img alt="..." class="d-block img-fluid" src="<%= item.image.url%>"/>
      <div class="carousel-caption d-none d-md-block">
        <h3 class="text-white">
          <%= link_to "#{item.name}", admin_item_path(item), class: 'text-white' %>
        </h3>
      </div>
    </div>
  <% end %>
</div>