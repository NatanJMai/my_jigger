<% @title = (@menu.persisted? ? "Edit Menu" : "Create New Menu") %>

<%= render 'layouts/partials/page_title', subtitle: "Menus", title: (@menu.persisted? ? "Edit Menu" : "Add Menu") %>

<%= simple_form_for model, html: { id: 'add-menu-form' } do |f| %>

  <div class="row">
    <div class="col-12">
      <div class="row">
        <div class="col-xxl-8">
          <div class="card">
            <div class="card-header d-block p-3">
              <h4 class="card-title mb-1">Menu Details</h4>
              <p class="text-muted mb-0">To add or modify the menu, please provide the necessary
                details in the fields below.</p>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-12">
                  <div class="mb-3">
                    <label class="form-label">Menu Name
                      <span class="text-danger">*</span>
                    </label>
                    <%= f.input :name,
                                label: false,
                                required: true,
                                input_html: { placeholder: 'Enter menu name', class: 'form-control' },
                                wrapper: false %>
                  </div>
                </div>
                <div class="col-12">
                  <div class="mb-3">
                    <label class="form-label">Release Date
                      <span class="text-muted">(Optional)</span>
                    </label>
                    <%= f.input :release_date,
                                as: :date,
                                label: false,
                                input_html: { class: 'form-control' },
                                wrapper: false %>
                  </div>
                </div>
                <div class="col-12">
                  <div>
                    <label class="form-label">Description
                      <span class="text-muted">(Optional)</span>
                    </label>
                    <div id="snow-editor" style="height: 100px;">
                      <%= f.object.description.html_safe if f.object.description.present? %>
                    </div>
                    <%= f.input :description,
                                as: :text,
                                input_html: { id: 'model_description_hidden_input', style: 'display:none;' },
                                wrapper: false,
                                label: false %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-xxl-4">
          <div class="card">
            <div class="card-header d-block p-3">
              <h4 class="card-title mb-1">Status and Organization</h4>
              <p class="text-muted mb-0">Set the menu's status and organizational tags.</p>
            </div>
            <div class="card-body">
              <div class="mb-3">
                <label class="form-label">Status (Active)
                  <span class="text-danger">*</span>
                </label>
                <%= f.input :status,
                            as: :boolean,
                            label: false,
                            hint: 'Check to make this menu active and visible.',
                            wrapper_html: { class: 'form-check form-switch' } %>
              </div>
              <div class="mb-3">
                <%= f.input :data_imported,
                            as: :boolean,
                            label: false,
                            hint: 'Is this data imported? Check to mark this menu as imported.',
                            wrapper_html: { class: 'form-check form-switch' } %>
              </div>
            </div>
          </div>
          <div class="card">
            <div class="card-header d-block p-3">
              <h4 class="card-title mb-1">Organization Info</h4>
            </div>
            <div class="card-body">
              <%= render partial: 'admin/menus/organization_info', locals: { organization: @organization } %>
            </div>
          </div>
        </div>
      </div>
      <div class="mt-2 mb-4 d-flex gap-2 justify-content-center">
        <%= f.button :submit, 'Save Menu', class: "btn btn-success" %>
      </div>
    </div>
  </div>
<% end %>