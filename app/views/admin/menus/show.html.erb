<% @title = menu.name %>

<%# 1. Page Title and Subtitle (from the template) %>
<%= render 'layouts/partials/page_title', subtitle: "Menu Management", title: menu.name %>

<div class="row">
  <div class="col-12">

    <%# 3. Secondary Navbar (Tabs) - Now placed within the main content area %>
    <nav class="navbar secondary-navbar card mb-3"> <%# Added card and mb-3 for template consistency %>
      <div class="container-fluid p-0">
        <ul class="nav nav-tabs border-0" id="secondaryTabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab1-tab" data-bs-toggle="tab" data-bs-target="#tab1"
                    type="button" role="tab" aria-controls="tab1" aria-selected="true">
              Dashboard
            </button>
          </li>

          <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab7-tab" data-bs-toggle="tab" data-bs-target="#tab7"
                    type="button" role="tab" aria-controls="tab7" aria-selected="false">
              AI Assistant
            </button>
          </li>

          <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab4-tab" data-bs-toggle="tab" data-bs-target="#tab4"
                    type="button" role="tab" aria-controls="tab4" aria-selected="false">
              Matrix
            </button>
          </li>

          <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab5-tab" data-bs-toggle="tab" data-bs-target="#tab5"
                    type="button" role="tab" aria-controls="tab5" aria-selected="false">
              ABC Analysis
            </button>
          </li>

          <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab6-tab" data-bs-toggle="tab" data-bs-target="#tab6"
                    type="button" role="tab" aria-controls="tab6" aria-selected="false">
              Import Data
            </button>
          </li>
        </ul>
      </div>
    </nav>

    <%# 4. Tab Content (The partials you render) %>
    <div class="tab-content" id="tabContent">
      <%= render partial: 'admin/menus/partials/tab1' %>
      <%= render partial: 'admin/menus/partials/tab7' %>
      <%= render partial: 'admin/menus/partials/tab4' %>
      <%= render partial: 'admin/menus/partials/tab5' %>
      <%= render partial: 'admin/menus/partials/tab6' %>
    </div>

  </div>
</div>

<%# 5. Optional Javascript/Footer %>

