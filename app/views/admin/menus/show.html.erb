<div class="row">
  <div class="col-5">
    <div class="container jigger-form item-info">
      <%= render partial: 'admin/menus/partials/menu_info' %>
    </div>
  </div>

  <div class="col-2">
    <div class="container jigger-form child-list sale-item blue">
      <%= render partial: 'layouts/shared/sale_items/total_sale_item',
                 locals: { label: 'Total Sales (M)',
                           total: menu.total_item_orders(:total_amount_cents)} %>
    </div>

    <div class="container jigger-form child-list sale-item purple">
      <%= render partial: 'layouts/shared/sale_items/number_orders_item',
                 locals: { label: 'Nr of Orders M',
                           total: menu.total_item_orders(:quantity) } %>
    </div>

    <!-- FIXME: Need to calculate the best day of Menu  -->
    <div class="container jigger-form child-list sale-item orange">
      <%= render partial: 'layouts/shared/sale_items/best_day_item',
                 locals: { label: 'The Best Day',
                           total: items.first.best_day_label } %>
    </div>
  </div>

  <div class="col-3">
    <div class="container jigger-form category-performance">
      <%= render partial: 'admin/menus/partials/menu_sales_pie' %>
    </div>
  </div>
</div>

<div class="row">
  <div class="custom-container col-7">
    <div class="row">
      <div class="col-12">
        <div class="container jigger-form child-list">
          <div class="row">
            <div class="col-12">
              <%= render partial: 'admin/menus/partials/sales_performance' %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-12">
        <div class="container jigger-form child-list">
          <%= render partial: 'admin/menus/partials/price_vs_costs' %>
        </div>
      </div>

<!--      <div class="col-5">-->
<!--        <div class="container jigger-form child-list matrix-popularity ">-->
          <%#= render partial: 'admin/menus/partials/matrix/menu_matrix' %>
<!--        </div>-->
<!--      </div>-->
    </div>
  </div>

  <div class="ranking-container col-3">
    <div class="col-12">
      <div class="container jigger-form child-list">
        <div class="row">
          <div class="col-12">
            <%= render partial: 'admin/menus/partials/ranking_items' %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%= render partial: 'layouts/cards/menu_card',
           locals: { url: new_admin_organization_import_job_path(current_organization),
                     title: 'Jobs',
                     class: '',
                     text: "#{menu.name} Jobs" } %>