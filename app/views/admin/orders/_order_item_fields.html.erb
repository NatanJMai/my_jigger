<tr class="nested-fields">
  <td>
    <%= f.collection_select :item_id, @organization.items.only_active.order(:name), :id, :name,
                            { prompt: "Select Item" }, { class: "form-select", required: true } %>
  </td>

  <td><%= f.number_field :quantity, class: "form-control item-quantity", placeholder: "1", min: 1, required: true %></td>

  <td>
    <%= f.hidden_field :_destroy %>
    <%= link_to_remove_association f, class: "btn btn-sm btn-danger" do %>
      &times;
    <% end %>
  </td>
</tr>