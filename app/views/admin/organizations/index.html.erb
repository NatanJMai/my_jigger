<% @title = "My Organizations" %>

<%= render 'layouts/partials/page_title', subtitle: "Admin", title: "Organization Management",
           new_url: new_admin_organization_path %>

<div class="row">
  <% organizations.each do |organization| %>
    <div class="col-12">
      <%= render 'admin/organizations/card', organization: organization %>
    </div>
  <% end %>
</div>