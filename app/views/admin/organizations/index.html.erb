<h2 class="display-4">My Organizations</h2>

<div class="separator"></div>

<div class="container-fluid p-0">
  <div class="row">
    <% organizations.each do |organization| %>
      <%= render 'admin/organizations/card', organization: organization %>
    <% end %>

    <%= render partial: 'layouts/new_button', locals: { url: new_admin_organization_path }  %>
  </div>
</div>






