<h4 class="display-7">
  <%= organization.name %>
  <%= link_to edit_admin_organization_path(organization) do %>
    <i class="fa-regular fa-pen-to-square edit-button"></i>
  <% end %>
</h4>

<div class="separator"></div>

<div class="container-fluid p-0">
  <div class="row">
    <%= render partial: 'layouts/cards/menu_card',
               locals: { url: admin_organization_categories_path(organization),
                         title: 'Categories',
                         class: '',
                         text: "#{organization.name} Categories" } %>

    <%= render partial: 'layouts/cards/menu_card',
               locals: { url: admin_organization_menus_path(organization),
                         title: 'Menus',
                         class: '',
                         text: "#{organization.name} Menus" } %>

    <%= render partial: 'layouts/cards/menu_card',
               locals: { url: admin_organization_items_path(organization),
                         title: 'Items',
                         class: '',
                         text: "#{organization.name} Items" } %>

    <%= render partial: 'layouts/cards/menu_card',
               locals: { url: admin_organization_ingredients_path(organization),
                         title: 'Ingredients',
                         class: '',
                         text: "#{organization.name} Ingredients" } %>

    <%= render partial: 'layouts/cards/menu_card',
               locals: { url: admin_organization_orders_path(organization),
                         title: 'Orders',
                         class: '',
                         text: "#{organization.name} Orders" } %>

  </div>
</div>

