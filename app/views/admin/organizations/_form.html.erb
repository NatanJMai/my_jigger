<div class="container jigger-form">
  <%= simple_form_for(model, html: { class: 'row row-cols' } ) do |f| %>

    <%= render partial: 'layouts/shared/form/header',
               locals: { title: 'Add/Save Organization' } %>

    <div class="row">
      <div class="col-8">
        <div class="row">
          <div class="col-8">
            <%= f.input :name, hint: 'Organization name', wrapper_html: { class: 'jigger-label' } %>
          </div>

          <div class="col-4">
            <%= f.input :status, label: 'Status (Active)', hint: 'Is this organization active?',
                        wrapper_html: { class: 'jigger-label' } %>
          </div>

        </div>
        <div class="row">
          <div class="col-6">
            <%= f.input :email,
                        label: 'Email',
                        hint: 'Best email to reach',
                        wrapper_html: { class: 'jigger-label' } %>
          </div>


          <div class="col-6">
            <%= f.input :address, label: 'Address', hint: 'Organization address',
                        wrapper_html: { class: 'jigger-label' } %>
          </div>
        </div>

        <div class="row">
          <div class="col-3">
            <%= f.button :submit, "Add/Save Item", class: "form-btn"  %>
          </div>
        </div>
      </div>


      <div class="col-4">
        <div class="vertical-line">
          <% if organization.image.present? %>
            <!-- Show the existing image -->
            <%= image_tag organization.image.url, alt: "Uploaded Image", class: "img-thumbnail shadow-sm form-photo"%>
          <% else %>
            <!-- Show the upload button -->
            <label for="image-upload" class="btn btn-outline-primary img-thumbnail shadow-sm form-photo">
              Upload Image
            </label>
          <% end %>

          <!-- Hidden File Input -->
          <%= f.file_field :image, id: "image-upload", class: "d-none" %>
        </div>
      </div>
    </div>
  <% end %>
</div>
