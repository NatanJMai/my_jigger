<div class="container jigger-form">
  <%= simple_form_for(model, html: { class: 'row row-cols' } ) do |f| %>

    <%= render partial: 'layouts/shared/form/header',
               locals: { title: 'Add/Save Item',
                         subtitle: 'Item details' } %>

    <div class="row">
      <div class="col-8">
        <div class="row">
          <div class="col-6">
            <%= f.input :name, hint: 'Menu name', wrapper_html: { class: 'jigger-label' } %>
          </div>

          <div class="col-3">
            <%= f.association :category, as: :select,
                              collection: f.object.organization.categories.active.order(:name),
                              prompt: 'Select a category',
                              hint: 'Menu released at',
                              wrapper_html: { class: 'jigger-label' } %>
          </div>

          <div class="col-3">
            <%= f.input :customer_price,
                        label: 'Customer Price',
                        hint: 'Enter Customer Price',
                        wrapper_html: { class: 'jigger-label' } %>
          </div>
        </div>

        <div class="row">
          <div class="col-3">
            <%= f.input :status, label: 'Status (Active)', hint: 'Is this item active?',
                        wrapper_html: { class: 'jigger-label' } %>
          </div>

          <div class="col-3">
            <%= f.input :data_imported, label: 'Data Imported?', hint: 'Is this item data imported?',
                        wrapper_html: { class: 'jigger-label' } %>
          </div>
        </div>

        <div class="row">
          <div class="col-12">
            <%= f.input :prep_method,
                        as: :text,
                        hint: 'Item prepare method of this item',
                        wrapper_html: { class: 'jigger-label' } %>
          </div>
        </div>

        <div class="row">
          <div class="col-3">
            <%= f.button :submit, "Add/Save Item", class: "form-btn"  %>
          </div>
        </div>
  </div>

  <div class="col-4">
    <div class="vertical-line">
      <% if item.image.present? %>
        <!-- Show the existing image -->
        <%= image_tag item.image.url, alt: "Uploaded Image", class: "img-thumbnail shadow-sm form-photo"%>
      <% else %>
        <!-- Show the upload button -->
        <label for="image-upload" class="btn btn-outline-primary img-thumbnail shadow-sm form-photo">
          Upload Image
        </label>
      <% end %>

      <!-- Hidden File Input -->
      <%= f.file_field :image, id: "image-upload", class: "d-none" %>
    </div>
  </div>
  </div>
</div>
<% end %>
