<% @title = model.persisted? ? "Edit Item" : "Create New Item" %>

<%= render 'layouts/partials/page_title', subtitle: "Cost Management", title: model.persisted? ? "Edit Item" : "Add Item" %>

<%= simple_form_for model, html: { id: 'add-item-form' } do |f| %>

  <div class="row">
    <div class="col-12">
      <div class="row">
        <div class="col-xxl-8">
          <div class="card">
            <div class="card-header d-block p-3">
              <h4 class="card-title mb-1">Item Information</h4>
              <p class="text-muted mb-0">To add a new menu item, please provide the necessary
                details in the fields below.</p>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-12">
                  <div class="mb-3">
                    <label class="form-label">Item Name
                      <span class="text-danger">*</span>
                    </label>
                    <%= f.input :name,
                                label: false,
                                required: true,
                                input_html: { placeholder: 'Enter item name', class: 'form-control' },
                                wrapper: false %>
                  </div>
                </div>
                <div class="col-12">
                  <div>
                    <label class="form-label">Prep Method (Description)
                      <span class="text-muted">(Optional)</span>
                    </label>
                    <div id="snow-editor" style="height: 100px;">
                      <%= f.object.prep_method.html_safe if f.object.prep_method.present? %>
                    </div>
                    <%= f.input :prep_method,
                                as: :text,
                                input_html: { id: 'model_prep_method_hidden_input', style: 'display:none;' },
                                wrapper: false,
                                label: false %>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="card">
            <div class="card-header d-block p-3">
              <h4 class="card-title mb-1">Item Image</h4>
              <p class="text-muted mb-0">To upload an item image, please use the option below to
                select and upload the relevant file.</p>
            </div>
            <div class="card-body">
              <div class="row">
                <% if f.object.persisted? && f.object.image.present? %>
                  <div class="col-6">
                    <div class="mb-4 p-3 border rounded bg-light">
                      <h5 class="mb-3 text-success">Current Image:</h5>
                      <div class="d-flex align-items-center">
                        <%= image_tag f.object.image.url, class: "img-thumbnail me-4", style: "max-width: 150px; max-height: 150px;" %>
                        <div class="flex-grow-1">
                          <p class="mb-1 fw-semibold"><%= f.object.image.file.filename if f.object.image.file.present? %></p>
                          <div class="form-check mt-2">
                            <%= f.check_box :remove_image, class: "form-check-input", id: "remove_image_check" %>
                            <label class="form-check-label text-danger" for="remove_image_check">Remove current image</label>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>
                <div class="col-6">
                  <div class="dropzone" data-plugin="dropzone" data-previews-container="#file-previews"
                       data-upload-preview-template="#uploadPreviewTemplate" id="myAwesomeDropzone">
                    <div class="fallback">
                      <%= f.input :image, as: :file, wrapper: false %>
                    </div>
                    <div class="dz-message needsclick">
                      <div class="avatar-lg mx-auto mb-3">
                        <span class="avatar-title bg-info-subtle text-info rounded-circle">
                          <i class="fs-24 ti ti-cloud-upload"></i>
                        </span>
                      </div>
                      <h4 class="mb-2">Drop files here or click to upload.</h4>
                      <p class="text-muted fst-italic mb-3">You can drag images here, or
                        browse files via the button below.</p>
                      <button class="btn btn-sm shadow btn-default" type="button">Browse
                        Images
                      </button>
                    </div>
                  </div>
                  <div class="dropzone-previews mt-3" id="file-previews"></div>
                  <div class="d-none" id="uploadPreviewTemplate">
                    <div class="card mt-1 mb-0 border-dashed border">
                      <div class="p-2">
                        <div class="row align-items-center">
                          <div class="col-auto">
                            <img alt="" class="avatar-sm rounded bg-light" data-dz-thumbnail="" src="#"/>
                          </div>
                          <div class="col ps-0">
                            <a class="fw-semibold" data-dz-name="" href="javascript:void(0);"></a>
                            <p class="mb-0 text-muted" data-dz-size=""></p>
                          </div>
                          <div class="col-auto">
                            <a class="btn btn-link btn-lg text-danger" data-dz-remove="" href="">
                              <i class="ti ti-x"></i>
                            </a>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-xxl-4">
          <div class="card">
            <div class="card-header d-block p-3">
              <h4 class="card-title mb-1">Pricing</h4>
              <p class="text-muted mb-0">Set the selling price for the menu item.</p>
            </div>
            <div class="card-body">
              <div class="mb-3">
                <label class="form-label">Selling Price (BRL)
                  <span class="text-danger">*</span>
                </label>
                <%= f.input :customer_price,
                            label: false,
                            as: :decimal,
                            input_html: { placeholder: '29.90', class: 'form-control' },
                            required: true,
                            wrapper: false %>
              </div>
            </div>
          </div>
          <div class="card">
            <div class="card-header d-block p-3">
              <h4 class="card-title mb-1">Organization</h4>
              <p class="text-muted mb-0">Organize your item by selecting the menu, category, and status.</p>
            </div>
            <div class="card-body">
              <div class="mb-3">
                <label class="form-label">Menu
                  <span class="text-danger">*</span>
                </label>
                <%= f.association :menu,
                                  collection: @organization.menus.order(:name),
                                  label: false,
                                  required: true,
                                  prompt: 'Choose Menu',
                                  input_html: { class: 'form-select' },
                                  wrapper: false %>
              </div>
              <div class="mb-3">
                <label class="form-label">Category
                  <span class="text-danger">*</span>
                </label>
                <%= f.association :category,
                                  collection: @organization.categories.order(:name),
                                  label: false,
                                  required: true,
                                  prompt: 'Choose Category',
                                  input_html: { class: 'form-select' },
                                  wrapper: false %>
              </div>
              <div class="mb-3">
                <label class="form-label">Status
                  <span class="text-danger">*</span>
                </label>
                <%= f.input :status,
                            as: :select,
                            collection: [['Active', true], ['Inactive', false]],
                            prompt: 'Choose Status',
                            label: false,
                            required: true,
                            input_html: { class: 'form-select form-control my-1 my-md-0' },
                            wrapper: false %>
              </div>
              <div class="mb-3">
                <%= f.input :data_imported,
                            as: :select,
                            collection: [['Yes', true], ['No', false]],
                            prompt: 'Choose Option',
                            label: 'Data Imported',
                            input_html: { class: 'form-select form-control my-1 my-md-0' },
                            wrapper: false %>
              </div>
            </div>
          </div>
          <% if model.persisted? %>
          <div class="card">
            <div class="card-header d-block p-3">
              <h4 class="card-title mb-1">Recipe & Costs</h4>
              <p class="text-muted mb-0">Manage the recipe and cost breakdown for this item.</p>
            </div>
            <div class="card-body">
              <div class="d-grid gap-2">
                <%= link_to "Add Recipe / Cost Breakdown",
                            edit_admin_item_datasheet_path(model, model.datasheet || :new),
                            class: "btn btn-primary" %>
                <% if model.datasheet.present? %>
                  <small class="text-muted">
                    Current CMV: <%= number_to_percentage(model.cmv, precision: 1) %>
                  </small>
                <% else %>
                  <small class="text-muted">
                    No recipe configured yet
                  </small>
                <% end %>
              </div>
            </div>
          </div>
          <% end %>
        </div>
      </div>
      <div class="mt-2 mb-4 d-flex gap-2 justify-content-center">
        <%= f.button :submit, 'Save Item', class: "btn btn-success" %>
      </div>
    </div>
  </div>
<% end %>

<% content_for :javascript do %>
  <%= vite_javascript_tag 'js/pages/ecommerce-add-product.js' %>
<% end %>
