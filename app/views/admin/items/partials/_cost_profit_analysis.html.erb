<div class="card mb-4">
  <div class="card-header bg-light">
    <h5 class="card-title mb-0">
      <i class="ti ti-chart-pie me-2"></i>Cost & Profit Analysis
    </h5>
  </div>
  <div class="card-body">
    <div class="row g-4">
      <div class="col-md-3">
        <div class="text-center">
          <h6 class="text-muted text-uppercase fs-xs mb-2">Selling Price</h6>
          <h3 class="fw-bold text-primary mb-0">
            <%= humanized_money_with_symbol Money.new(item.customer_price_cents) %>
          </h3>
          <small class="text-muted">BRL</small>
        </div>
      </div>

      <div class="col-md-3">
        <div class="text-center">
          <h6 class="text-muted text-uppercase fs-xs mb-2">Total Cost</h6>
          <h3 class="fw-bold text-danger mb-0">
            <%= humanized_money_with_symbol Money.new(item.costs) %>
          </h3>
          <small class="text-muted">Ingredients</small>
        </div>
      </div>

      <div class="col-md-3">
        <div class="text-center">
          <h6 class="text-muted text-uppercase fs-xs mb-2">Profit</h6>
          <h3 class="fw-bold text-success mb-0">
            <%= humanized_money_with_symbol Money.new(item.profit) %>
          </h3>
          <small class="text-muted">
            <%= number_to_percentage(item.markup_percentage, precision: 1) %> markup
          </small>
        </div>
      </div>

      <div class="col-md-3">
        <div class="text-center">
          <h6 class="text-muted text-uppercase fs-xs mb-2">CMV</h6>
          <%
            cmv_value = item.cmv.present? ? item.cmv.round(1) : 0
            cmv_class = case cmv_value
                       when 0..30 then 'success'
                       when 30.1..35 then 'warning'
                       else 'danger'
                       end
            cmv_label = case cmv_value
                       when 0..30 then 'Good'
                       when 30.1..35 then 'Warning'
                       else 'High'
                       end
          %>
          <h3 class="fw-bold text-<%= cmv_class %> mb-0">
            <%= number_to_percentage(cmv_value, precision: 1) %>
          </h3>
          <small class="text-muted">
            <span class="badge bg-<%= cmv_class %>-subtle text-<%= cmv_class %>">
              <%= cmv_label %>
            </span>
          </small>
        </div>
      </div>
    </div>

    <% if item.datasheet.present? && item.datasheet.datasheet_lines.any? %>
      <hr class="my-4">
      <div class="row">
        <div class="col-12">
          <h6 class="text-muted text-uppercase fs-xs mb-3">Recipe Breakdown</h6>
          <div class="table-responsive">
            <table class="table table-sm table-bordered">
              <thead class="table-light">
                <tr>
                  <th>Ingredient</th>
                  <th class="text-center">Quantity</th>
                  <th class="text-center">Unit Cost</th>
                  <th class="text-end">Calculated Cost</th>
                </tr>
              </thead>
              <tbody>
                <% item.datasheet.datasheet_lines.each do |line| %>
                  <tr>
                    <td><%= line.ingredient.name %></td>
                    <td class="text-center">
                      <%= number_with_precision(line.quantity, precision: 2) %>
                      <small class="text-muted"><%= line.ingredient.unit %></small>
                    </td>
                    <td class="text-center">
                      <%= humanized_money_with_symbol Money.new(line.ingredient.cost_cents) %>
                      <small class="text-muted">/ <%= line.ingredient.volume %><%= line.ingredient.unit %></small>
                    </td>
                    <td class="text-end fw-medium">
                      <%= humanized_money_with_symbol Money.new(line.calculated_price) %>
                    </td>
                  </tr>
                <% end %>
                <tr class="table-secondary">
                  <td colspan="3" class="text-end fw-bold">Total Cost:</td>
                  <td class="text-end fw-bold">
                    <%= humanized_money_with_symbol Money.new(item.costs) %>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    <% else %>
      <div class="alert alert-info mb-0 mt-3">
        <i class="ti ti-info-circle me-2"></i>
        No recipe configured. <%= link_to "Add ingredients", new_admin_item_datasheet_path(item) %> to calculate costs.
      </div>
    <% end %>
  </div>
</div>
