<tr>
  <td class="ps-3">
    <input class="form-check-input form-check-input-light fs-14 item-check mt-0" type="checkbox" value="<%= item.id %>"/>
  </td>
  <td>
    <div class="d-flex">
      <div class="avatar-md me-3">
        <% if item.image.present? %>
          <img alt="<%= item.name %>" class="img-fluid rounded" src="<%= item.image.icon.url %>"/>
        <% else %>
          <div class="avatar-md bg-light d-flex align-items-center justify-content-center rounded">
            <span class="text-muted">No Img</span>
          </div>
        <% end %>
      </div>
      <div>
        <h5 class="mb-0">
          <%= item.display_item_link %>
        </h5>
        <p class="text-muted mb-0 fs-xs"><%= item.menu.name if item.menu.present? %></p>
      </div>
    </div>
  </td>

  <td data-column="category"><%= item.category&.name %></td>
  <td data-column="cmv">
    <% cmv_value = item.cmv.present? ? item.cmv.round(1) : 0 %>
    <% cmv_class = case cmv_value
                   when 0..30 then 'success'
                   when 30.1..35 then 'warning'
                   else 'danger'
                   end %>
    <span class="badge badge-soft-<%= cmv_class %> fs-xxs">
      <%= number_to_percentage(cmv_value, precision: 1) %>
    </span>
  </td>
  <td data-column="price">
    <%= humanized_money_with_symbol Money.new(item.customer_price_cents) %>
  </td>
  <td><%= item.order_items.sum(:quantity) %></td>
  <td data-column="status" data-filter-value="<%= item.status.to_s %>">
    <%
      status_text = item.status ? 'Active' : 'Inactive'
      status_class = item.status ? 'success' : 'danger'
    %>
    <span class="badge badge-soft-<%= status_class %> fs-xxs"><%= status_text %></span>
  </td>
  <td>
    <div class="d-flex justify-content-center gap-1" onclick="event.stopPropagation()">
      <%= link_to admin_item_datasheet_path(item), class: 'btn btn-default btn-icon btn-sm rounded-circle', title: 'Recipe & Costs' do %>
        <i class="ti ti-file-spreadsheet fs-lg"></i>
      <% end %>

      <a class="btn btn-default btn-icon btn-sm" href='<%= url_for(controller: 'admin/items', action: 'show', id: item.id) %>'>
        <i class="ti ti-chart-bar fs-lg"></i>
      </a>

      <a class="btn btn-default btn-icon btn-sm" href='<%= url_for(controller: 'admin/items', action: 'edit', id: item.id) %>'>
        <i class="ti ti-edit fs-lg"></i>
      </a>

      <%= button_to admin_item_path(item),
                    method: :delete,
                    title: 'Delete Item',
                    class: "btn btn-default btn-icon btn-sm",
                    data: { turbo_confirm: "Are you sure you want to delete this item?" } do %>
        <i class="ti ti-trash fs-lg"></i>
      <% end %>
    </div>
  </td>
</tr>