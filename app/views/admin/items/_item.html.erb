<tr>
  <td class="ps-3">
    <input class="form-check-input form-check-input-light fs-14 product-item-check mt-0" type="checkbox" value="<%= item.id %>"/>
  </td>
  <td>
    <div class="d-flex">
      <div class="avatar-md me-3">
        <% if item.image.present? %>
          <img alt="<%= item.name %>" class="img-fluid rounded" src="<%= item.image.icon.url %>"/>
        <% else %>
          <div class="avatar-md bg-light d-flex align-items-center justify-content-center rounded">
            <span class="text-muted">No Img</span>
          </div>
        <% end %>
      </div>
      <div>
        <h5 class="mb-0">
          <%# item.display_item_link renders the linked name %>
          <%= item.display_item_link %>
        </h5>
        <p class="text-muted mb-0 fs-xs">by: <%= item.organization.name %></p>
      </div>
    </div>
  </td>
  <%# SKU (Using item.id as a temporary SKU placeholder if not available) %>
  <td>SKU-<%= item.id %></td>
  <%# Category %>
  <td data-column="category"><%= item.category.name %></td>
  <%# Stock (Placeholder - replace with actual stock attribute if available) %>
  <td>
    <h5 class="fs-base mb-0 fw-medium">N/A</h5>
  </td>
  <%# Price %>
  <td data-column="price">
    <%= humanized_money_with_symbol Money.new(item.customer_price_cents) %>
  </td>
  <%# Orders (Placeholder) %>
  <td>0</td>
  <%# Rating (Placeholder) %>
  <td>
    <span class="text-warning">
      <span class="ti ti-star"></span>
    </span>
    <span class="ms-1"><a class="link-reset fw-semibold" data-sort="rating" href="#">(0)</a></span>
  </td>
  <%# Status (Using item.status) %>
  <td data-column="status" data-filter-value="<%= item.status.to_s %>">
    <%
      status_text = item.status ? 'Published' : 'Draft/Inactive'
      status_class = item.status ? 'success' : 'danger'
    %>
    <span class="badge badge-soft-<%= status_class %> fs-xxs"><%= status_text %></span>
  </td>
  <%# Published (Using data_imported for status/date info) %>
  <td>
    <% data_imported_label = item.boolean_label(item.data_imported, label = { true => 'Imported', false => 'Not Imported' }) %>
    <small class="text-muted"><%= data_imported_label.gsub(/<[^>]*>/, '') %></small>
  </td>
  <%# Actions %>
  <td>
    <div class="d-flex justify-content-center gap-1">
      <%= link_to admin_item_datasheet_path(item), class: 'btn btn-default btn-icon btn-sm rounded-circle', title: 'Open CMV' do %>
        <i class="fa-solid fa-file-import fs-lg"></i>
      <% end %>

      <%= link_to edit_admin_item_path(item), class: 'btn btn-default btn-icon btn-sm rounded-circle', title: 'Edit Item' do %>
        <i class="fa-regular fa-pen-to-square fs-lg"></i>
      <% end %>

      <%= button_to admin_item_path(item),
                    method: :delete,
                    title: 'Delete Item',
                    class: "btn btn-default btn-icon btn-sm rounded-circle",
                    data: { turbo_confirm: "Are you sure you want to delete this item?" } do %>
        <i class="fas fa-trash-alt fs-lg"></i>
      <% end %>
    </div>
  </td>
</tr>