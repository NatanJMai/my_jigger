<tr>
  <th scope="row">
    <% if item.image.present? %>
    <!-- Use the icon version of the image -->
    <%= image_tag item.image.icon.url, alt: "#{item.name} Icon", class: "img-thumbnail" %>
    <% else %>
      <!-- Fallback for no image -->
      <span class="text-muted">No Image</span>
    <% end %>
  </th>
  <td><%= item.name %></td>

  <td class="minimal"><%= humanized_money_with_symbol Money.new(item.customer_price_cents) %></td>
  <td class="minimal"><%= item.boolean_label(item.status) %></td>
  <td class="minimal"><%= item.boolean_label(item.data_imported,
                                             label = { true => 'Imported',
                                                       false => 'Not Imported' }) %>
  </td>
  <td class="minimal">
    <%= link_to admin_item_datasheet_path(item), class: 'btn btn-success' do %>
      <i class="bi bi-pencil-square"></i> CMV
    <% end %>

    <%= link_to admin_item_path(item), class: 'btn btn-success' do %>
      <i class="bi bi-pencil-square"></i> VIEW
    <% end %>

    <%= link_to edit_admin_item_path(item), class: 'btn btn-info' do %>
      <i class="bi bi-pencil-square"></i> EDIT
    <% end %>

    <%= button_to admin_item_path(item), class: "btn btn-danger",
                  method: :delete, form: { data: { turbo: true, method: :delete } } do %>

      <i class="bi bi-trash"></i> DELETE
    <% end %>
  </td>
</tr>
