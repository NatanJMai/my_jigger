<tr>
  <th scope="row">
    <% if item.image.present? %>
    <!-- Use the icon version of the image -->
    <%= image_tag item.image.icon.url, alt: "#{item.name} Icon", class: "img-thumbnail" %>
    <% else %>
      <!-- Fallback for no image -->
      <span class="text-muted">No Image</span>
    <% end %>
  </th>
  <td><%= item.display_item_link %></td>

  <td class="minimal"><%= humanized_money_with_symbol Money.new(item.customer_price_cents) %></td>
  <td class="minimal"><%= item.boolean_label(item.status) %></td>
  <td class="minimal"><%= item.boolean_label(item.data_imported,
                                             label = { true => 'Imported',
                                                       false => 'Not Imported' }) %>
  </td>
  <td class="minimal">
    <%= link_to admin_item_datasheet_path(item), class: 'btn', title: 'Open CMV' do %>
      <i class="fa-solid fa-file-import item-datasheet-icon"></i>
    <% end %>

    <%= link_to edit_admin_item_path(item), class: 'btn', title: 'Edit Item' do %>
      <i class="fa-regular fa-pen-to-square edit-button"></i>
    <% end %>

    <%= button_to admin_item_path(item),
                  method: :delete,
                  title: 'Delete Item',
                  class: "trash-icon-button" do %>

      <i class="fas fa-trash-alt"></i> <!-- Font Awesome Trash Icon -->
    <% end %>
  </td>
</tr>
