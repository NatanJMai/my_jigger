<div class="row">
  <div class="col-5">
    <div class="container jigger-form item-info">
      <%= render partial: 'admin/items/partials/item_info' %>
    </div>
  </div>

  <div class="col-2">
    <div class="container jigger-form child-list sale-item blue">
      <%= render partial: 'layouts/shared/sale_items/total_sale_item' %>
    </div>

    <div class="container jigger-form child-list sale-item purple">
      <%= render partial: 'layouts/shared/sale_items/number_orders_item' %>
    </div>

    <div class="container jigger-form child-list sale-item orange">
      <%= render partial: 'layouts/shared/sale_items/best_day_item' %>
    </div>
  </div>

  <div class="col-3">
    <div class="container jigger-form category-performance">
      <%= render partial: 'admin/menus/partials/item_production_costs' %>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-7">
    <div class="container jigger-form child-list">
      <div class="row">
        <div class="col-12">
          <%= render partial: 'admin/items/partials/sales_performance' %>
        </div>
      </div>
    </div>
  </div>

  <div class="col-3">
    <div class="container jigger-form weekly-sales child-list">
      <%= render partial: 'admin/items/partials/weekly_sales' %>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-7">
    <div class="container jigger-form child-list">
      <div class="row">
        <div class="col-12">
          <%= render partial: 'admin/items/partials/revenue_performance' %>
        </div>
      </div>
    </div>
  </div>
  <div class="col-3">
    <div class="container jigger-form category-performance child-list">
      <%= render partial: 'admin/menus/partials/category_performance' %>
    </div>
  </div>
</div>