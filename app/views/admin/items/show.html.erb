<% @title = "Product Details - #{item.name}" %>

<%= render 'layouts/partials/page_title', subtitle: "Ecommerce", title: item.name %>

<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-body p-4 p-md-5">

        <div class="row g-4">

          <div class="col-xl-4">
            <div class="card card-top-sticky border-0 shadow-sm">
              <div class="card-body p-0">

                <div class="carousel slide carousel-fade" data-bs-ride="carousel" id="itemImagesCarousel">
                  <div class="carousel-inner" role="listbox">
                    <div class="carousel-item active">
                      <% if item.image.present? %>
                        <div style="max-height: 300px; height: 300px; overflow: hidden;" class="bg-light d-flex align-items-center justify-content-center rounded-top">
                          <%= image_tag item.image.medium_detail.url, alt: "#{item.name} Image", class: "img-fluid w-100 h-100 object-fit-contain rounded-top" %>
                        </div>
                      <% else %>
                        <div class="d-block w-100 bg-light text-center py-5 rounded-top" style="height: 300px; display: flex; align-items: center; justify-content: center; flex-direction: column;">
                          <i class="ti ti-photo fs-xl text-muted"></i>
                          <p class="text-muted mt-2">Image Placeholder</p>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>

                <div class="p-3 d-flex flex-wrap align-items-center justify-content-between border-bottom border-light gap-2">

                  <div class="d-flex align-items-center gap-2">
                    <h5 class="text-muted mb-0">
                      <span class="fw-bold text-danger"><%= humanized_money_with_symbol item.customer_price %></span>
                    </h5>
                    <% if item.status %>
                      <span class="badge bg-success-subtle text-success fs-base rounded-pill">Active</span>
                    <% else %>
                      <span class="badge bg-danger-subtle text-danger fs-base rounded-pill">Inactive</span>
                    <% end %>
                  </div>

                  <div class="d-flex align-items-center gap-2">
                    <a class="btn btn-light btn-sm" href='<%= edit_admin_item_path(item) %>'>
                      <i class="ti ti-pencil fs-lg me-1"></i> Edit
                    </a>

                    <%= button_to admin_item_path(item), method: :delete,
                                  data: { turbo_confirm: 'Are you sure you want to delist/delete this item?' },
                                  form_class: 'd-inline',
                                  class: 'btn btn-danger btn-sm' do %>
                      <i class="ti ti-circle-dashed-x fs-lg me-1"></i> Delete
                    <% end %>
                  </div>
                </div>

              </div>
            </div>
          </div>

          <div class="col-xl-8">
            <h2 class="mb-4"><%= item.name %></h2>

            <div class="row mb-5 g-4 border-bottom pb-4">
              <div class="col-md-4">
                <h6 class="mb-1 text-muted text-uppercase fs-xs">Category:</h6>
                <p class="fw-medium mb-0"><%= item.category.name if item.category %></p>
              </div>
              <div class="col-md-4">
                <h6 class="mb-1 text-muted text-uppercase fs-xs">Published On:</h6>
                <p class="fw-medium mb-0">
                  <%= item.created_at.strftime('%d %b, %Y at %I:%M %p') %>
                </p>
              </div>
              <div class="col-md-4">
                <h6 class="mb-1 text-muted text-uppercase fs-xs">Best Sales Day:</h6>
                <p class="fw-medium mb-0">
                  <span class="badge bg-secondary-subtle text-secondary"><%= item.best_day_label || 'N/A' %></span>
                </p>
              </div>
              <div class="col-md-4">
                <h6 class="mb-1 text-muted text-uppercase fs-xs">Total Orders:</h6>
                <p class="fw-medium mb-0">
                  <%= item.total_orders(attribute: :quantity) %> units
                </p>
              </div>
              <div class="col-md-4">
                <h6 class="mb-1 text-muted text-uppercase fs-xs">Total Revenue:</h6>
                <p class="fw-medium mb-0">
                  <%= humanized_money_with_symbol Money.new(item.total_orders(attribute: :total_amount_cents)) %>
                </p>
              </div>
              <div class="col-md-4">
                <h6 class="mb-1 text-muted text-uppercase fs-xs">Average Cost:</h6>
                <p class="fw-medium mb-0">
                  <%= humanized_money_with_symbol Money.new(item.costs) %>
                </p>
              </div>
            </div>

            <h5 class="text-uppercase text-muted fs-xs mb-2">Preparation Method:</h5>
            <p class="fs-base"><%= item.prep_method || "No preparation method or detailed description available." %></p>
          </div>
        </div>

        <div class="mt-5 pt-3 border-top border-light">
          <div class="row g-4 mb-4">
            <div class="col-xl-6">
              <%= render partial: 'admin/items/partials/item_production_costs', locals: { item: item } %>
            </div>
            <div class="col-xl-6">
              <%= render partial: 'admin/items/partials/weekly_sales', locals: { item: item } %>
            </div>
          </div>

          <div class="row g-4">
            <div class="col-xl-6">
              <%= render partial: 'admin/items/partials/sales_performance', locals: { item: item } %>
            </div>
            <div class="col-xl-6">
              <%= render partial: 'admin/items/partials/revenue_performance', locals: { item: item } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<% content_for :javascript do %>
  <%= vite_javascript_tag 'js/pages/custom-table.js' %>
  <%= vite_javascript_tag 'js/pages/chart-apex-pie.js' %>
  <%= vite_javascript_tag 'js/pages/chart-apex-bar.js' %>
  <script src="https://apexcharts.com/samples/assets/github-data.js"></script>
  <script src="https://apexcharts.com/samples/assets/irregular-data-series.js"></script>
  <%= vite_javascript_tag 'js/pages/chart-apex-area.js' %>
  <%= vite_javascript_tag 'js/pages/chart-apex-line.js' %>
<% end %>