<!-- Item Information from Menu -->
<span><b><%= item&.name %></b></span>
<div class="row jigger-label">
  <div class="col-6 align-left info-description">
    <%= humanized_money_with_symbol Money.new(item.customer_price) %>
  </div>
  <div class="col-6 align-right info-label">Price (BRL)</div>
</div>

<div class="row jigger-label">
  <div class="col-6 align-left info-description"><%= item&.category&.name %></div>
  <div class="col-6 align-right info-label">Category</div>
</div>

<div class="row jigger-label">
  <div class="col-6 align-left info-description"><%= item.cmv ? number_to_percentage(item.cmv, precision: 1) : 'N/A' %></div>
  <div class="col-6 align-right info-label">CMV</div>
</div>

<div class="row jigger-label">
  <div class="col-6 align-left info-description"><%= item.status ? 'Active' : 'Inactive' %></div>
  <div class="col-6 align-right info-label">Status</div>
</div>

<hr><div class="row jigger-label"><div class="align-center info-label">Prep Method</div></div>
